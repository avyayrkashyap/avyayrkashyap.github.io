---
// src/pages/now.astro
// Edit the arrays below and bump `updated` whenever things change.
import Layout from '../layouts/Layout.astro';

const updated = 'November 2026';

// `img.position` picks which part of a shot survives the 16:10 crop
const building = [
  {
    title: 'Augment',
    meta: 'Personal agent for the Mac',
    body: 'Press ⌥Space anywhere, talk, and it works out what I meant and does it. Small tasks, done on the side.',
    href: '/augment',
    img: { src: '/assets/augment/augment-cover.png', alt: "Augment's pill under the MacBook notch, pasting a checklist into Notes", position: 'top' },
  },
  {
    title: 'tvUI',
    meta: 'Android TV launcher',
    body: 'My own home screen for our TCL Google TV. A minimal launcher, driven by the remote’s D-pad, that I own the source to.',
    img: { src: '/assets/now/tv-ui.jpg', alt: 'tvUI: a large YouTube tile over a starry mountain backdrop, with a row of streaming apps below' },
  },
];

// Spine colours are sampled from each cover
const reading = [
  { title: 'Wool', author: 'Hugh Howey', cover: '/assets/now/wool.webp', ratio: '1316 / 2000', spine: '#B5161E', ink: '#0A0A0A' },
  { title: 'Onward', author: 'Howard Schultz', cover: '/assets/now/onward.png', ratio: '435 / 644', spine: '#F6F2EA', ink: '#0F6E4A' },
];

const watching = [
  {
    title: 'Silo',
    meta: 'Apple TV+',
    body: 'The show based on Wool, which is why the book is on my shelf. Same stairs, different medium.',
    img: { src: '/assets/now/silo.jpg', alt: 'A still from Silo: Juliette crouched on the silo’s spiral staircase' },
  },
];

const playing = [
  {
    title: 'EA Sports FC 26',
    meta: 'EA Sports',
    body: 'The one game that always makes it onto the screen. Mostly kickoff matches against friends, where the trash talk lasts longer than the game.',
    img: { src: '/assets/now/eafc26.jpg', alt: 'EA Sports FC 26 key art: two players walking out of the tunnel at a Champions League night', position: 'left' },
  },
];

const sections = [
  { id: 'building', label: 'Building', items: building },
  { id: 'reading', label: 'Reading', items: [] },
  { id: 'watching', label: 'Watching', items: watching },
  { id: 'playing', label: 'Playing', items: playing },
];
---

<Layout title="Now — Avyay">
  <article class="now">
    <header class="now-intro">
      <span class="type-body-sm text-disabled">Updated {updated}</span>
      <h1 class="type-title">What I'm up to now.</h1>
      <p class="now-lead type-body-md">A snapshot of where my time and attention go at the moment. If you're reading this much later, I'm probably doing something else.</p>

      <dl class="now-facts">
        <div class="now-fact">
          <dt class="type-h4">Location</dt>
          <dd class="type-body-sm">Jersey City, working in New York</dd>
        </div>
        <div class="now-fact">
          <dt class="type-h4">Role</dt>
          <dd class="type-body-sm">Sr. UX Designer at Moody's, designing structured finance analysis workflows</dd>
        </div>
      </dl>
    </header>

    {/* data-chapters / data-chapter: tracked by the sidebar (src/scripts/chapters.js) */}
    <div class="now-main" data-chapters="Now">
      {sections.map(({ id, label, items }) => (
        <section class="now-section" id={id} data-chapter>
          <h2 class="now-section-label type-h4">{label}</h2>
          {id === 'reading' ? (
            /* Books stand angled, spine toward you; hovering one turns it
               to face you, cover first. */
            <div class="shelf">
              {reading.map(({ title, author, cover, ratio, spine, ink }) => (
                <figure class="shelf-slot" style={`--ratio: ${ratio}; --spine: ${spine}; --ink: ${ink}`}>
                  <div class="book" tabindex="0" aria-label={`${title} by ${author}`}>
                    <img class="book-face book-cover" src={cover} alt="" />
                    <span class="book-face book-spine" aria-hidden="true">
                      <span class="book-spine-title">{title}</span>
                      <span class="book-spine-author">{author.split(' ').pop()}</span>
                    </span>
                    <span class="book-face book-pages" aria-hidden="true"></span>
                    <span class="book-face book-back" aria-hidden="true"></span>
                  </div>
                  <figcaption>
                    <span class="type-body-sm shelf-title">{title}</span>
                    <span class="type-body-xs">{author}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <div class="now-list">
              {items.map(({ title, meta, body, href, img }) => (
                <div class="now-item">
                  <span class="now-item-media">
                    <img src={img.src} alt={img.alt} loading="lazy" style={img.position && `object-position: ${img.position}`} />
                  </span>
                  <div class="now-item-copy">
                    <h3 class="type-h2">{href ? <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{title}</a> : title}</h3>
                    <span class="now-item-meta type-body-xs">{meta}</span>
                    <p class="type-body-sm">{body}</p>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>

    <p class="now-credit type-body-xs">
      Inspired by <a href="https://sive.rs/now2" target="_blank" rel="noopener">Derek Sivers' nownownow movement</a>.
    </p>
  </article>
</Layout>

<style>
  .now {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(96px, 16vh, 168px) clamp(16px, 9vw, 122px) 120px;
  }

  .now-intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 48px;
  }

  .now-lead {
    max-width: 640px;
  }

  .now-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin: 16px 0 0;
  }

  .now-fact {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--color-cool-bg);
    border-radius: 12px;
    padding: 20px 24px;
  }

  .now-fact dd {
    margin: 0;
  }

  .now-main {
    container-type: inline-size;
  }

  .now-section {
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
  }

  .now-section + .now-section {
    margin-top: 48px;
  }

  .now-section-label {
    display: block;
    margin-bottom: 32px;
  }

  .now-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* A row of Building or Watching: thumbnail beside its copy */
  .now-item {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .now-item-media {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-cool-bg);
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .now-item-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .now-item h3 {
    margin-bottom: 0;
  }

  .now-item h3 a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .now-item h3 a:hover {
    color: var(--color-text-accent);
  }

  .now-item-meta {
    display: block;
    margin: 4px 0 10px;
  }

  @container (max-width: 520px) {
    .now-item {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  .now-credit {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .now-credit a {
    color: var(--color-text-accent);
  }

  /* ── Books ──
     Each book is a box of four faces in 3D: cover in front, spine on the
     left, page edges on the right, a back. At rest it's turned so the spine
     leads; on hover it swings round to face you, lifts, and casts a blue
     shadow. */
  .shelf {
    --book-h: 220px;
    --depth: 28px;
    display: flex;
    gap: 56px;
    padding: 24px 0 0 40px;
  }

  .shelf-slot {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    /* Each book gets its own vanishing point, so both turn the same way */
    perspective: 700px;
    perspective-origin: 50% 35%;
  }

  .book {
    position: relative;
    z-index: 1;
    --book-w: calc(var(--book-h) * var(--ratio));
    width: var(--book-w);
    height: var(--book-h);
    transform-style: preserve-3d;
    transform: rotateY(46deg);
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: default;
    outline: none;
  }

  .book:hover,
  .book:focus-visible {
    transform: translateY(-10px) translateZ(24px) rotateY(-4deg);
  }

  .book-face {
    position: absolute;
    backface-visibility: hidden;
  }

  .book-cover {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateZ(calc(var(--depth) / 2));
    border-radius: 1px 3px 3px 1px;
    box-shadow: 0 0 0 transparent;
    transition: box-shadow 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .book:hover .book-cover,
  .book:focus-visible .book-cover {
    box-shadow: 0 18px 36px -10px color-mix(in srgb, var(--color-text-accent) 45%, transparent);
  }

  .book-spine,
  .book-pages {
    top: 0;
    left: calc(50% - var(--depth) / 2);
    width: var(--depth);
    height: 100%;
  }

  .book-spine {
    transform: translateX(calc(var(--book-w) / -2)) rotateY(-90deg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    box-sizing: border-box;
    writing-mode: vertical-rl;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.18), transparent 30%, transparent 70%, rgba(0, 0, 0, 0.18)), var(--spine);
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .book-spine-title {
    font-size: 13px;
  }

  .book-spine-author {
    font-size: 9px;
  }

  .book-pages {
    transform: translateX(calc(var(--book-w) / 2)) rotateY(90deg);
    background: repeating-linear-gradient(90deg, #FBFAF6 0 1px, #E7E3DA 1px 2px);
  }

  .book-back {
    inset: 0;
    transform: translateZ(calc(var(--depth) / -2)) rotateY(180deg);
    background: var(--spine);
  }

  .shelf-slot figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .shelf-title {
    color: var(--color-text-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .book,
    .book-cover {
      transition: none;
    }
  }

  @container (max-width: 420px) {
    .shelf {
      --book-h: 180px;
      gap: 40px;
      padding-left: 24px;
    }
  }
</style>
