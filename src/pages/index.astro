---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
---

<Layout title="Avyay — Product Designer">
  {/* Before the content parses, so it never flashes in: hide the blocks for
      sketch.js to draw in. Hard loads only: the document is still parsing
      then, and window.__sketched survives in-site navigation. Coming home
      from a case study, the card morphs into place instead. The timeout is a
      backstop if the script never runs */}
  <script is:inline>
    if (document.readyState === 'loading' && !window.__sketched && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('sketching');
      setTimeout(function () { document.documentElement.classList.remove('sketching'); }, 8000);
    }
  </script>
  <Hero />
  <Work />
</Layout>

<script>
  import '../scripts/sketch.js';
</script>

<style is:global>
  html.sketching :is(
    .sidebar-current, .sidebar-nav, .sidebar-foot > *, .sidebar-pager,
    .hero-hello, .hero-card, .hero-title, .hero-lead,
    .work-label, .work-cover, .work-title, .work-desc, .work-tags, .work-view
  ):not(.sketched) {
    opacity: 0;
  }

  .sketch-layer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    overflow: hidden;
  }

  .sketch-box {
    position: absolute;
    border: 1px solid var(--c);
    border-radius: 2px;
    background: color-mix(in srgb, var(--c) 6%, transparent);
  }

  .sketch-cursor {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: flex-start;
  }

  .sketch-cursor svg {
    fill: var(--c);
    stroke: var(--color-bg-default);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .sketch-cursor span {
    margin: 14px 0 0 -2px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--c);
    color: #fff;
    font: 11px/1.3 var(--font-ui);
    white-space: nowrap;
  }
</style>
