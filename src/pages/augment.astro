---
// src/pages/augment.astro
// Case study for Augment, a local voice layer for the Mac. The product visuals are live recreations driven by
// src/scripts/augment.js (the mascot's own keyframes, the notch pill's own open/close), so they stay crisp and move.
import Layout from '../layouts/Layout.astro';

const apps = [
  { id: 'notes', name: 'Notes', why: "Built with Notes' own Format menu: a real heading, then a real checklist you can tick." },
  { id: 'claude', name: 'Claude', why: 'Markdown, which the chat renders as a heading and a list once you send it.' },
  { id: 'mail', name: 'Mail', why: 'Rich text: a heading and bullets, with a plain twin for fields that only take plain text.' },
  { id: 'terminal', name: 'Terminal', why: 'One line. A newline in a terminal runs a command, so the list is flattened on purpose.' },
];

const states = [
  { id: 'idle', label: 'Idle', anim: 'Breathe' },
  { id: 'listening', label: 'Listening', anim: 'Lean in, brackets open with your voice' },
  { id: 'thinking', label: 'Thinking', anim: 'Typing dots' },
  { id: 'done', label: 'Note done', anim: 'Happy hop' },
  { id: 'quiet', label: 'Too quiet', anim: 'Tilt' },
  { id: 'error', label: 'Something failed', anim: 'Shake' },
];
---

<Layout title="Augment — Avyay">
  <article class="case-study au" data-chapters>

    <!-- ── Hero ── -->
    <header class="au-hero">
      <span class="type-body-sm text-disabled">/Experiment</span>
      <h1 class="type-title">Augment</h1>
      <p class="au-prose type-body-md">A voice layer for the Mac. Press ⌥Space anywhere, talk, and a local Whisper and Llama turn what you said into tidy text, typed straight into the app you were using: a checklist in Notes, Markdown in Claude, one safe line in Terminal. Nothing leaves the laptop.</p>

      <!-- Live: the pill grows out of the notch, listens, tidies, and pastes into Notes -->
      <div class="au-desk au-desk--hero" data-au="hero" role="img" aria-label="Animation: Augment's black pill grows out of a MacBook notch, shows words as they're spoken, then pastes a formatted checklist into Notes">
        <div class="au-menubar" aria-hidden="true">
          <span class="au-menubar-left"><b></b>Notes<i>File</i><i>Edit</i><i>Format</i><i>View</i></span>
          <span class="au-menubar-right"><i class="au-dot"></i><i class="au-dot"></i><i>Sat 12:31</i></span>
        </div>
        <div class="au-notch" aria-hidden="true"></div>
        <div class="au-pill is-hidden" aria-hidden="true">
          <div class="au-row">
            <div class="au-slot" data-mascot="listening"></div>
            <div class="au-text"><span class="au-line au-hint">Listening…</span></div>
          </div>
          <div class="au-bar">
            <span class="au-target"><img src="/assets/augment/icon-notes.png" alt="" width="18" height="18" />Notes</span>
            <span class="au-side"></span>
          </div>
        </div>
        <div class="au-notes" aria-hidden="true">
          <div class="au-notes-chrome"><i></i><i></i><i></i></div>
          <div class="au-notes-body"><span class="au-caret"></span></div>
        </div>
      </div>
    </header>

    <!-- ── Meta ── -->
    <section class="au-meta">
      <div class="au-meta-item"><span class="type-h4">Role</span><span class="type-body-sm">Design & build</span></div>
      <div class="au-meta-item"><span class="type-h4">Built with</span><span class="type-body-sm">Claude Code</span></div>
      <div class="au-meta-item"><span class="type-h4">Stack</span><span class="type-body-sm">Electron, whisper.cpp, Llama 3.1 8B</span></div>
      <div class="au-meta-item"><span class="type-h4">Timeline</span><span class="type-body-sm">October 2026</span></div>
    </section>

    <!-- ── Where it started ── -->
    <section id="origin" class="au-section" data-chapter="Where it started">
      <h2 class="au-label type-h4">Where it started</h2>
      <h3 class="au-statement type-h1">An ear and a brain, glued together by a web page.</h3>
      <p class="au-prose type-body-md">The first version was a single HTML file. You pressed Record, talked, and pressed Stop. The page sent the audio to Whisper running on the Mac (the ears), passed the words to Llama 3.1 8B (the brain) to remove the ums and add punctuation, and showed both. Whisper and Llama never spoke to each other; the page was the glue.</p>

      <div class="au-flow" data-au="flow" aria-label="Diagram: microphone to Whisper to Llama to clean text">
        <div class="au-flow-node"><span class="au-flow-icon">🎙</span><strong class="type-h3">You talk</strong><span class="type-body-xs">16 kHz audio</span></div>
        <div class="au-flow-pipe"><i></i></div>
        <div class="au-flow-node"><span class="au-flow-icon">👂</span><strong class="type-h3">Whisper</strong><span class="type-body-xs">audio → words, ~1.4 s</span></div>
        <div class="au-flow-pipe"><i></i></div>
        <div class="au-flow-node"><span class="au-flow-icon">🧠</span><strong class="type-h3">Llama 3.1 8B</strong><span class="type-body-xs">words → tidy text</span></div>
        <div class="au-flow-pipe"><i></i></div>
        <div class="au-flow-node"><span class="au-flow-icon">📋</span><strong class="type-h3">Clipboard</strong><span class="type-body-xs">paste it yourself</span></div>
      </div>

      <div class="au-numbers">
        <div class="au-number"><span class="au-figure">0</span><span class="type-body-sm">accounts, logins or API keys</span></div>
        <div class="au-number"><span class="au-figure">2–5 s</span><span class="type-body-sm">from Stop to tidy text, once warm</span></div>
        <div class="au-number"><span class="au-figure">6.4 GB</span><span class="type-body-sm">self-contained Mac app, both models inside</span></div>
      </div>

      <div class="au-two">
        <figure class="au-shot au-shot--app">
          <img src="/assets/augment/full-app.png" alt="Augment's first window: a Record button, the mascot, a live transcript card and a clipboard card" width="840" height="1120" loading="lazy" />
        </figure>
        <div class="au-two-copy">
          <h3 class="type-h2">Then it became an app</h3>
          <p class="au-prose type-body-md">Wrapping it in Electron gave it a global hotkey, a menu bar icon and a window of floating cards: a record button, the live transcript, and what came out the other end. Both servers ship inside the app, Llama starts when you begin talking so it's warm by the time you stop, and it frees its 5 GB after five quiet minutes.</p>
          <p class="au-prose type-body-md">It worked, but it still ended with "now go and paste it". The rest of this project was about removing that last step and everything that made it feel like a tool you visit instead of something that's just there.</p>
        </div>
      </div>
    </section>

    <!-- ── Augie ── -->
    <section id="augie" class="au-section" data-chapter="Meet Augie">
      <h2 class="au-label type-h4">Meet Augie</h2>
      <h3 class="au-statement type-h1">A face made of two brackets and two squares.</h3>
      <p class="au-prose type-body-md">Augment needed a way to say "I'm listening" and "I'm thinking" without words, at 28 pixels tall. Augie is the product's name drawn as a face: <code>[··]</code>. Every state is a keyframe animation (seven tracks: the whole body, each bracket, each eye) that I could tune in a small editor built into the app. Move your pointer around: the eyes follow it, and every so often Augie blinks.</p>

      <div class="au-states">
        {states.map(({ id, label, anim }) => (
          <figure class="au-state">
            <div class="au-state-stage"><div class="au-state-mascot" data-mascot={id}></div></div>
            <figcaption><strong class="type-h3">{label}</strong><span class="type-body-xs">{anim}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ── Live transcript ── -->
    <section id="transcript" class="au-section" data-chapter="Words as you speak">
      <h2 class="au-label type-h4">Words as you speak</h2>
      <h3 class="au-statement type-h1">Ink settles as Whisper stops changing its mind.</h3>
      <p class="au-prose type-body-md">Whisper doesn't stream; it transcribes a clip. So every 1.5 seconds Augment sends everything said so far and redraws it. Words that came back the same as last time are drawn in full ink; the newest stay light until Whisper stops revising them. You can watch it correct "check list" into "checklist" below. When you stop, one final pass over the whole recording produces the real transcript.</p>

      <div class="au-card" data-au="transcript">
        <div class="au-card-head"><span class="type-h4">Live transcript</span><span class="au-pass type-body-xs">Whisper pass 1</span></div>
        <p class="au-live"></p>
      </div>
    </section>

    <!-- ── Typing where you are ── -->
    <section id="apps" class="au-section" data-chapter="Typing where you are">
      <h2 class="au-label type-h4">Typing where you are</h2>
      <h3 class="au-statement type-h1">One note, written the way each app reads.</h3>
      <p class="au-prose type-body-md">The clipboard step went first. When you press ⌥Space, Augment notes which app is in front, and when the note is ready it presses ⌘V there for you. Knowing the app turned out to matter for more than pasting: the same checklist has to land differently in each one.</p>

      <div class="au-apps" data-au="apps">
        <div class="au-app-tabs" role="tablist" aria-label="Apps">
          {apps.map(({ id, name }, i) => (
            <button class="au-app-tab" role="tab" type="button" data-app={id} aria-selected={i === 0 ? 'true' : 'false'}>
              <img src={`/assets/augment/icon-${id}.png`} alt="" width="22" height="22" />{name}
              <i class="au-app-progress"></i>
            </button>
          ))}
        </div>
        <div class="au-app-panels">
          <div class="au-app-panel" data-app="notes">
            <div class="au-doc au-doc--notes">
              <p class="au-doc-h">Trip to Paris</p>
              <p class="au-check">Book flights</p>
              <p class="au-check">Renew my passport</p>
              <p class="au-check">Find a pet sitter</p>
            </div>
          </div>
          <div class="au-app-panel" data-app="claude" hidden>
            <div class="au-doc au-doc--claude"><pre>## Trip to Paris
- [ ] Book flights
- [ ] Renew my passport
- [ ] Find a pet sitter</pre></div>
          </div>
          <div class="au-app-panel" data-app="mail" hidden>
            <div class="au-doc au-doc--mail">
              <p class="au-mail-to type-body-xs">To: Sam · Subject: Before we go</p>
              <p class="au-doc-h">Trip to Paris</p>
              <ul><li>☐ Book flights</li><li>☐ Renew my passport</li><li>☐ Find a pet sitter</li></ul>
            </div>
          </div>
          <div class="au-app-panel" data-app="terminal" hidden>
            <div class="au-doc au-doc--terminal"><pre><span>~ %</span> Trip to Paris Book flights Renew my passport Find a pet sitter</pre></div>
          </div>
          {apps.map(({ id, why }) => (
            <p class="au-app-why type-body-sm" data-app={id} hidden={id !== 'notes'}>{why}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- ── The harness ── -->
    <section id="harness" class="au-section" data-chapter="Teaching an 8B model">
      <h2 class="au-label type-h4">Teaching an 8B model to format</h2>
      <h3 class="au-statement type-h1">Rails, not a longer prompt.</h3>
      <p class="au-prose type-body-md">Formatting meant the model had to decide what's a heading, what's a list and what's just a sentence, and drop the words people use to dictate a list ("first one is", "let's make it a checklist") without dropping anything else. A small model asked to do all of that in one go behaved like one:</p>

      <ol class="au-tries">
        <li><strong class="type-h3">One prompt, Markdown out</strong><span class="type-body-sm">Made a list once in eight tries, kept "make this a checklist" in the note, and answered "Can you summarise this?" instead of copying it.</span></li>
        <li><strong class="type-h3">Worked examples</strong><span class="type-body-sm">Lists improved, but it quietly dropped words ("on the way home", "Hey, just wanted to say") and invented headings from questions.</span></li>
        <li><strong class="type-h3">Fixed fields, checked in code</strong><span class="type-body-sm">Llama fills a JSON shape the server enforces; code removes the spoken instructions first and checks everything Llama returns. Every real dictation I threw at it came out right.</span></li>
      </ol>

      <div class="au-harness" data-au="harness" aria-label="Animation: a spoken note going through Augment's formatting steps">
        <div class="au-step" data-step="1">
          <span class="au-step-label type-h4">What Whisper heard</span>
          <p class="au-heard"><span class="t-head">Trip to Paris.</span> <span class="t-ask">Let's make it a checklist.</span> <span class="t-count">First one is</span> book flights. <span class="t-count">Second,</span> renew my passport. <span class="t-count">And the last one is</span> find a pet sitter.</p>
        </div>
        <div class="au-step" data-step="2">
          <span class="au-step-label type-h4">Code removes the request</span>
          <p class="type-body-sm">"Let's make it a checklist." is cut before Llama sees it, and becomes a hint instead: <span class="au-chip">kind: checklist</span></p>
        </div>
        <div class="au-step" data-step="3">
          <span class="au-step-label type-h4">Llama fills fixed fields</span>
          <pre class="au-json">{`{
  "heading": "Trip to Paris",
  "kind": "checklist",
  "items": ["Book flights", "Renew my passport", "Find a pet sitter"],
  "before": "",
  "after": ""
}`}</pre>
        </div>
        <div class="au-step" data-step="4">
          <span class="au-step-label type-h4">Code checks Llama's work</span>
          <div class="au-guards">
            <span class="au-chip">✓ heading is the whole first sentence you said</span>
            <span class="au-chip">✓ counting words stripped from items</span>
            <span class="au-chip">✓ nothing repeated after the list</span>
          </div>
        </div>
        <div class="au-step" data-step="5">
          <span class="au-step-label type-h4">What lands in Notes</span>
          <div class="au-doc au-doc--notes au-doc--small">
            <p class="au-doc-h">Trip to Paris</p>
            <p class="au-check">Book flights</p>
            <p class="au-check">Renew my passport</p>
            <p class="au-check">Find a pet sitter</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── The pill ── -->
    <section id="pill" class="au-section" data-chapter="Out of the notch">
      <h2 class="au-label type-h4">From floating pill to notch</h2>
      <h3 class="au-statement type-h1">The pill learned where it lives.</h3>
      <p class="au-prose type-body-md">When you start talking from another app, the full window would steal focus. So Augment shows a small pill instead: it never takes focus, mirrors what's happening, and disappears a few seconds after the note lands. Its design changed four times.</p>

      <ol class="au-evolution">
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v1</span>
            <h3 class="type-h2">A floating pill</h3>
            <p class="au-prose type-body-sm">Translucent grey, centred near the top of the screen, sliding in and fading out. It read well over any wallpaper but floated free of everything around it.</p>
          </div>
          <figure class="au-shot au-shot--pill"><img src="/assets/augment/pill-v1-live.png" alt="The first mini pill: a translucent dark grey rounded pill over a wallpaper, showing the mascot, words being transcribed and a red timer" width="960" height="192" loading="lazy" /></figure>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v2</span>
            <h3 class="type-h2">Knowing where it's going</h3>
            <p class="au-prose type-body-sm">Once Augment knew which app it was writing into, the pill showed that app's icon. The first attempt drew a grey placeholder; macOS only hands over the real icon through Quick Look.</p>
          </div>
          <div class="au-oldpill" aria-hidden="true">
            <div class="au-oldpill-slot" data-mascot="listening"></div>
            <span class="au-oldpill-text">Trip to Paris. Let's make <span>it a checklist.</span></span>
            <span class="au-oldpill-side">0:04</span>
            <img src="/assets/augment/icon-notes.png" alt="" width="24" height="24" />
          </div>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v3</span>
            <h3 class="type-h2">Out of the notch</h3>
            <p class="au-prose type-body-sm">Pure black, attached to the top edge, growing out of the MacBook notch and tucking back into it with the same motion reversed. macOS keeps windows below the menu bar, so this one has to ask to sit above it.</p>
          </div>
          <div class="au-desk au-desk--mini" data-au="notch" aria-hidden="true">
            <div class="au-menubar"><span class="au-menubar-left"><b></b>Notes<i>File</i><i>Edit</i></span><span class="au-menubar-right"><i>12:31</i></span></div>
            <div class="au-notch"></div>
            <div class="au-pill au-pill--one is-hidden">
              <div class="au-row">
                <div class="au-slot" data-mascot="listening"></div>
                <div class="au-text"><span class="au-line">Trip to Paris. Let's make <span class="au-tentative">it a checklist.</span></span></div>
                <span class="au-side au-rec">0:04</span>
                <img class="au-pill-icon" src="/assets/augment/icon-notes.png" alt="" width="20" height="20" />
              </div>
            </div>
          </div>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v4</span>
            <h3 class="type-h2">Two rows, one job each</h3>
            <p class="au-prose type-body-sm">The top is only for Augie and your words; the app and the timer moved to a bar underneath. Words got the full width, so a finished note fits on two lines.</p>
          </div>
          <div class="au-anatomy" aria-hidden="true">
            <div class="au-desk au-desk--still">
              <div class="au-notch"></div>
              <div class="au-pill">
                <div class="au-row">
                  <div class="au-slot" data-mascot="idle"></div>
                  <div class="au-text"><span class="au-line au-final">Trip to Paris ☐ Book flights ☐ Renew my passport ☐ Find a pet sitter</span></div>
                </div>
                <div class="au-bar">
                  <span class="au-target"><img src="/assets/augment/icon-notes.png" alt="" width="18" height="18" />Notes</span>
                  <span class="au-side">Pasted</span>
                </div>
              </div>
            </div>
            <ul class="au-callouts">
              <li><b>Ears</b> concave curves where it meets the screen edge, so it reads as the notch growing</li>
              <li><b>Below the notch</b> content starts at the menu bar's height, which on a notched Mac is the notch's</li>
              <li><b>Bottom bar</b> where the note is going, and what happened to it</li>
            </ul>
          </div>
        </li>
      </ol>
    </section>

    <!-- ── Bugs ── -->
    <section id="bugs" class="au-section" data-chapter="What broke">
      <h2 class="au-label type-h4">What broke, and what it taught me</h2>
      <div class="au-bugs">
        <div class="au-bug">
          <strong class="type-h3">The paste that never happened</strong>
          <p class="type-body-sm">Formatting "didn't work", so I tuned prompts. The real cause was in the terminal all along: Electron had changed its clipboard API, and every paste threw before pressing a key. Read the logs before blaming the model.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">A shortcut someone else owned</strong>
          <p class="type-body-sm">Notes' checklist shortcut, ⇧⌘L, opened another app's drawer on my Mac. Augment now clicks Format → Checklist in Notes' own menu, which nothing can intercept.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">The close that snapped shut</strong>
          <p class="type-body-sm">Playing the opening animation in reverse did nothing: Chromium won't restart an animation whose only change is its direction. Closing got its own copy of the keyframes.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">Formatting twice</strong>
          <p class="type-body-sm">A list followed by the same list as a paragraph looked like a double paste. It was Llama repeating the items in "what came after". Code now drops that field when it only echoes the list.</p>
        </div>
      </div>
    </section>

    <!-- ── Learnings ── -->
    <section id="learnings" class="au-section" data-chapter="Learnings">
      <h2 class="au-label type-h4">Learnings</h2>
      <div class="au-learnings">
        <div class="au-learning"><span class="au-learning-num">01</span><div><strong class="type-h3">Small models need rails</strong><p class="type-body-sm">Fixed fields and checks in code did what no amount of prompt wording could. The model decides what goes where; code makes sure it's sane.</p></div></div>
        <div class="au-learning"><span class="au-learning-num">02</span><div><strong class="type-h3">Test with how people actually talk</strong><p class="type-body-sm">Every fix came from a real dictation: "item number one is going to be", "this is going to be a checklist". Tidy sample sentences hid all of it.</p></div></div>
        <div class="au-learning"><span class="au-learning-num">03</span><div><strong class="type-h3">Use what's already on screen</strong><p class="type-body-sm">The app you're in, its own menus, the notch. The more Augment borrowed from the Mac, the less it felt like a separate tool.</p></div></div>
        <div class="au-learning"><span class="au-learning-num">04</span><div><strong class="type-h3">Check the plumbing first</strong><p class="type-body-sm">Three of the four worst bugs were platform changes, not design or model problems. Proof beats assumptions, every time.</p></div></div>
      </div>
    </section>

  </article>
</Layout>

<script>
  import '../scripts/augment.js';
</script>

<style is:global>
  /* Everything is namespaced under .au: the live visuals are built by augment.js, and Astro's scoped styles wouldn't
     reach elements created at runtime. The product surfaces (the pill, Augie, the desk) keep the app's own colours in
     both themes; the page around them uses the site's tokens. */
  .au {
    max-width: 860px;
    padding: 80px clamp(24px, 8vw, 100px) 120px;
    --au-black: #000;
    --au-ink: #e6ebe4;
    --au-soft: #8e959a;
    --au-rec: #ef6270;
    --au-serif: ui-serif, "New York", Georgia, serif;
  }
  .au code { font-size: 0.92em; padding: 1px 5px; border-radius: 5px; background: var(--color-quote-bg); }
  .au-prose { max-width: 680px; line-height: 1.6; }
  .au-prose + .au-prose { margin-top: 12px; }

  /* ── Hero ── */
  .au-hero { display: flex; flex-direction: column; gap: 16px; margin-bottom: 48px; }

  /* ── The desk: a slice of a Mac with a notch, where the pill lives ── */
  .au-desk {
    --notch-h: 28px;
    --notch-w: 150px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background:
      radial-gradient(120% 90% at 85% 110%, #e08a5a 0%, transparent 55%),
      radial-gradient(90% 80% at 10% 0%, #4b3f9b 0%, transparent 60%),
      linear-gradient(160deg, #2f2a5c, #7a4d6f 60%, #c9785a);
  }
  .au-desk--hero { height: 440px; margin-top: 8px; }
  .au-desk--mini { height: 170px; }
  .au-desk--still { height: 168px; }
  .au-menubar {
    position: absolute; inset: 0 0 auto; height: var(--notch-h);
    display: flex; align-items: center; justify-content: space-between; padding: 0 14px;
    background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(12px);
    color: rgba(255, 255, 255, 0.92); font: 600 12px/1 var(--font-sans);
  }
  .au-menubar-left, .au-menubar-right { display: flex; align-items: center; gap: 14px; }
  .au-menubar i { font-style: normal; font-weight: 500; }
  .au-menubar b { width: 11px; height: 13px; border-radius: 40% 40% 45% 45%; background: rgba(255, 255, 255, 0.92); }
