---
// src/pages/augment.astro
// Case study for Augment, a first step toward a personal agent on the Mac. The product visuals are live recreations
// driven by src/scripts/augment.js (the mascot's own keyframes, the notch pill's own open/close, the router's picks),
// so they stay crisp and move. The weather and score cards copy the app's widgets.js/widgets.css look.
import Layout from '../layouts/Layout.astro';

const apps = [
  { id: 'notes', name: 'Notes', why: "A real heading and a checklist you can tick." },
  { id: 'claude', name: 'Claude', why: 'Markdown, rendered once you send it.' },
  { id: 'mail', name: 'Mail', why: 'Rich text, with a plain-text twin.' },
  { id: 'terminal', name: 'Terminal', why: 'One line, since a newline runs a command.' },
];

const states = [
  { id: 'idle', label: 'Idle', anim: 'Breathe' },
  { id: 'listening', label: 'Listening', anim: 'Brackets follow your voice' },
  { id: 'thinking', label: 'Thinking', anim: 'Typing dots' },
  { id: 'done', label: 'Done', anim: 'Happy hop' },
  { id: 'quiet', label: 'Too quiet', anim: 'Tilt' },
  { id: 'error', label: 'Something failed', anim: 'Shake' },
];

const tools = [
  { id: 'type', name: 'Type', does: 'Pasted where I am' },
  { id: 'ask', name: 'Ask', does: 'Augie answers' },
  { id: 'search', name: 'Search', does: 'In my browser' },
  { id: 'weather', name: 'Weather', does: 'A card' },
  { id: 'scores', name: 'Scores', does: 'A card' },
];

const rails = [
  ['An unpunctuated quote got “answered”.', 'Answers and searches need something actually asked.'],
  ['It searched while I was typing in a text box.', 'In a text box, it types.'],
  ['18% of 240 came back as 48.', 'Llama writes 0.18 * 240; code works out 43.2.'],
  ['It mixed up “Friday” and “tomorrow”.', 'Code reads the day.'],
  ['It ignored a rule written as prose.', 'A line code reads: Answer here: weather, sports.'],
];

// weather icons as voice-app/widgets.js draws them: an overcast cloud, or a cloud with falling rain
const cloud = (fill: string, y: number) => `<path class="wi-cloud" transform="translate(0 ${y})" d="M20 46h26a10 10 0 0 0 0-20a14 14 0 0 0-26-3a11.5 11.5 0 0 0 0 23z" fill="${fill}"/>`;
const drops = `<g stroke="#7CC0FF" stroke-width="3" stroke-linecap="round">${[22, 32, 42].map(x => `<line class="wi-drop" x1="${x}" y1="51" x2="${x - 2}" y2="57"/>`).join('')}</g>`;
const icon = (rain: boolean, size: number) => `<svg class="wi" viewBox="0 0 64 64" width="${size}" height="${size}" aria-hidden="true">${rain ? cloud('#C9D2DC', -6) + drops : cloud('#DDE3EA', 2)}</svg>`;
const hours: [string, boolean, number][] = [['9 AM', false, 8], ['12 PM', true, 11], ['3 PM', true, 13], ['6 PM', true, 10], ['9 PM', false, 7]];
---

<Layout title="Augment — Avyay">
  <article class="case-study au" data-chapters>

    <!-- ── Hero ── -->
    <header class="au-hero">
      <span class="type-body-sm text-disabled">/Experiment</span>
      <h1 class="type-title">Augment</h1>
      <p class="au-prose type-body-md">A first step toward a personal agent that gets small tasks done on the side. I press ⌥Space anywhere on my Mac and talk; Augment works out what I meant and does it.</p>

      <!-- Live: the pill grows out of the notch, listens, tidies, and pastes into Notes -->
      <div class="au-desk au-desk--hero" data-au="hero" role="img" aria-label="Animation: Augment's black pill grows out of a MacBook notch, shows words as they're spoken, then pastes a formatted checklist into Notes">
        <div class="au-menubar" aria-hidden="true">
          <span class="au-menubar-left"><b></b>Notes<i>File</i><i>Edit</i><i>Format</i><i>View</i></span>
          <span class="au-menubar-right"><i class="au-dot"></i><i class="au-dot"></i><i>Sat 12:31</i></span>
        </div>
        <div class="au-notch" aria-hidden="true"></div>
        <div class="au-pill is-hidden" aria-hidden="true">
          <div class="au-row">
            <div class="au-slot" data-mascot="listening"></div>
            <div class="au-text"><span class="au-line au-hint">Listening…</span></div>
          </div>
          <div class="au-bar">
            <span class="au-target"><img src="/assets/augment/icon-notes.png" alt="" width="18" height="18" />Notes</span>
            <span class="au-side"></span>
          </div>
        </div>
        <div class="au-notes" aria-hidden="true">
          <div class="au-notes-chrome"><i></i><i></i><i></i></div>
          <div class="au-notes-body"><span class="au-caret"></span></div>
        </div>
      </div>
    </header>

    <!-- ── Meta ── -->
    <section class="au-meta">
      <div class="au-meta-item"><span class="type-h4">Role</span><span class="type-body-sm">Design & build</span></div>
      <div class="au-meta-item"><span class="type-h4">Built with</span><span class="type-body-sm">Claude Code</span></div>
      <div class="au-meta-item"><span class="type-h4">Stack</span><span class="type-body-sm">Electron, whisper.cpp, Llama 3.1 8B</span></div>
      <div class="au-meta-item"><span class="type-h4">Timeline</span><span class="type-body-sm">October 2026</span></div>
    </section>

    <!-- ── Why ── -->
    <section id="why" class="au-section" data-chapter="Why">
      <h2 class="au-label type-h4">Why I built it</h2>
      <h3 class="au-statement type-h1">Small tasks shouldn't pull me out of what I'm doing.</h3>
      <p class="au-prose type-body-md">Jot a to-do, check a number, see if it'll rain. Each one means switching apps. I wanted to say it once, from anywhere, and have it done.</p>

      <div class="au-two">
        <figure class="au-shot au-shot--app">
          <img src="/assets/augment/full-app.png" alt="Augment's first window: a Record button, the mascot, a live transcript card and a clipboard card" width="840" height="1120" loading="lazy" />
        </figure>
        <div class="au-two-copy">
          <h3 class="type-h2">It started as dictation</h3>
          <p class="au-prose type-body-md">Whisper heard me and Llama 3.1 8B tidied the words, both running on the Mac. But it was a window I had to visit, and I still had to paste.</p>
        </div>
      </div>
    </section>

    <!-- ── Router ── -->
    <section id="router" class="au-section" data-chapter="The router">
      <h2 class="au-label type-h4">From transcript to agent</h2>
      <h3 class="au-statement type-h1">First, work out what the note is for.</h3>
      <p class="au-prose type-body-md">A router picks one of five jobs for every note, from the words, the app in front, the website in a browser, and whether the cursor is in a text box.</p>

      <div class="au-router" data-au="router" aria-label="Animation: spoken notes being routed to Type, Ask, Search, Weather or Scores">
        <p class="au-said">“Can you send me the deck before Friday?”</p>
        <div class="au-signals type-body-xs">
          <span class="au-chip">App <b data-sig="app">Mail</b></span>
          <span class="au-chip">Website <b data-sig="site">—</b></span>
          <span class="au-chip">Text box <b data-sig="box">yes</b></span>
        </div>
        <div class="au-tools">
          {tools.map(({ id, name, does }) => (
            <div class:list={['au-tool', { 'is-on': id === 'type' }]} data-tool={id}><strong>{name}</strong><span class="type-body-xs">{does}</span></div>
          ))}
        </div>
        <p class="au-why type-body-sm">Written to someone, with the cursor in a message: typed there.</p>
      </div>

      <p class="au-prose type-body-md">When unsure, it types: a stray answer is easy to ignore, but a dictated sentence that never lands is lost. A labelled test set keeps it honest; 35 of 35 route correctly.</p>

      <h3 class="au-sub type-h2">Typing still has to land right</h3>
      <p class="au-prose type-body-md">The same note lands differently in each app, and any app or site can get its own instructions file (<code>Notes.md</code>, <code>mail.google.com.md</code>).</p>

      <div class="au-apps" data-au="apps">
        <div class="au-app-tabs" role="tablist" aria-label="Apps">
          {apps.map(({ id, name }, i) => (
            <button class="au-app-tab" role="tab" type="button" data-app={id} aria-selected={i === 0 ? 'true' : 'false'}>
              <img src={`/assets/augment/icon-${id}.png`} alt="" width="22" height="22" />{name}
              <i class="au-app-progress"></i>
            </button>
          ))}
        </div>
        <div class="au-app-panels">
          <div class="au-app-panel" data-app="notes">
            <div class="au-doc au-doc--notes">
              <p class="au-doc-h">Trip to Paris</p>
              <p class="au-check">Book flights</p>
              <p class="au-check">Renew my passport</p>
              <p class="au-check">Find a pet sitter</p>
            </div>
          </div>
          <div class="au-app-panel" data-app="claude" hidden>
            <div class="au-doc au-doc--claude"><pre>## Trip to Paris
- [ ] Book flights
- [ ] Renew my passport
- [ ] Find a pet sitter</pre></div>
          </div>
          <div class="au-app-panel" data-app="mail" hidden>
            <div class="au-doc au-doc--mail">
              <p class="au-mail-to type-body-xs">To: Sam · Subject: Before we go</p>
              <p class="au-doc-h">Trip to Paris</p>
              <ul><li>☐ Book flights</li><li>☐ Renew my passport</li><li>☐ Find a pet sitter</li></ul>
            </div>
          </div>
          <div class="au-app-panel" data-app="terminal" hidden>
            <div class="au-doc au-doc--terminal"><pre><span>~ %</span> Trip to Paris Book flights Renew my passport Find a pet sitter</pre></div>
          </div>
          {apps.map(({ id, why }) => (
            <p class="au-app-why type-body-sm" data-app={id} hidden={id !== 'notes'}>{why}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Rails ── -->
    <section id="rails" class="au-section" data-chapter="Rails">
      <h2 class="au-label type-h4">Rails, not prompts</h2>
      <h3 class="au-statement type-h1">A small model is fast and private, and wrong in predictable ways.</h3>
      <p class="au-prose type-body-md">Rewording the prompt never fixed much. A line of code that checked its work did. One prompt made a list once in eight tries; fixed fields plus checks get it right.</p>

      <div class="au-harness" data-au="harness" aria-label="Animation: a spoken note going through Augment's formatting steps">
        <div class="au-step" data-step="1">
          <span class="au-step-label type-h4">What Whisper heard</span>
          <p class="au-heard"><span class="t-head">Trip to Paris.</span> <span class="t-ask">Let's make it a checklist.</span> <span class="t-count">First one is</span> book flights. <span class="t-count">Second,</span> renew my passport. <span class="t-count">And the last one is</span> find a pet sitter.</p>
        </div>
        <div class="au-step" data-step="2">
          <span class="au-step-label type-h4">Code lifts the request</span>
          <p class="type-body-sm"><span class="au-chip">kind: checklist</span></p>
        </div>
        <div class="au-step" data-step="3">
          <span class="au-step-label type-h4">Llama fills fixed fields</span>
          <pre class="au-json">{`{
  "heading": "Trip to Paris",
  "kind": "checklist",
  "items": ["Book flights", "Renew my passport", "Find a pet sitter"],
  "before": "",
  "after": ""
}`}</pre>
        </div>
        <div class="au-step" data-step="4">
          <span class="au-step-label type-h4">Code checks Llama's work</span>
          <div class="au-guards">
            <span class="au-chip">✓ heading was a whole sentence</span>
            <span class="au-chip">✓ no counting words</span>
            <span class="au-chip">✓ no echoed list</span>
          </div>
        </div>
        <div class="au-step" data-step="5">
          <span class="au-step-label type-h4">What lands in Notes</span>
          <div class="au-doc au-doc--notes au-doc--small">
            <p class="au-doc-h">Trip to Paris</p>
            <p class="au-check">Book flights</p>
            <p class="au-check">Renew my passport</p>
            <p class="au-check">Find a pet sitter</p>
          </div>
        </div>
      </div>

      <p class="au-prose type-body-md au-after">The same fix, again and again:</p>
      <ul class="au-rails">
        <li class="au-rails-head type-h4"><span>Llama</span><span>The rail</span></li>
        {rails.map(([wrong, rail]) => (
          <li class="type-body-sm"><span>{wrong}</span><span>{rail}</span></li>
        ))}
      </ul>
    </section>

    <!-- ── Answers ── -->
    <section id="answers" class="au-section" data-chapter="Answers">
      <h2 class="au-label type-h4">Answers you can see</h2>
      <h3 class="au-statement type-h1">The weather and the football, right in the pill.</h3>
      <p class="au-prose type-body-md">Llama is offline, so I gave two daily questions their own answers: weather from Open-Meteo, scores from ESPN's public data. Llama reads the place or team; every number comes from the source.</p>

      <div class="au-answers" aria-label="Examples: a weather card and a score card inside Augment's black pill">
        <div class="au-answer">
          <div class="au-slot" data-mascot="idle"></div>
          <div class="wd wd-weather">
            <div class="wd-now">
              <Fragment set:html={icon(true, 58)} />
              <div class="wd-main">
                <div class="wd-place">Paris · Tomorrow</div>
                <div class="wd-temp">13°<span class="wd-unit">C</span></div>
                <div class="wd-desc">Light rain</div>
              </div>
              <div class="wd-side"><span>H 13°</span><span>L 6°</span><span class="wd-rain">☂ 80%</span></div>
            </div>
            <div class="wd-hours">
              {hours.map(([label, rain, temp]) => (
                <div class="wd-hour"><span>{label}</span><Fragment set:html={icon(rain, 22)} /><b>{temp}°</b></div>
              ))}
            </div>
          </div>
        </div>
        <div class="au-answer">
          <div class="au-slot" data-mascot="idle"></div>
          <div class="wd wd-score">
            <div class="wd-head"><span>Full time</span><span>Premier League</span></div>
            <div class="wd-match">
              <div class="wd-team wd-win"><span class="wd-crest wd-crest--big">L</span><span class="wd-name">Liverpool</span></div>
              <div class="wd-score-mid"><span class="wd-points">2<i>–</i>1</span></div>
              <div class="wd-team wd-team--r"><span class="wd-crest wd-crest--big">B</span><span class="wd-name">Brentford</span></div>
            </div>
            <div class="wd-next">Next <span class="wd-crest wd-crest--small">V</span> <b>Villarreal</b> · home · Tue 20 Oct</div>
          </div>
        </div>
      </div>

      <p class="au-prose type-body-md">Whisper and Llama still run on the Mac. Augment's own web requests go only to those two services, on an allow-list, and carry just a place or a team name. Searches go through my browser.</p>
    </section>

    <!-- ── Augie ── -->
    <section id="augie" class="au-section" data-chapter="Augie">
      <h2 class="au-label type-h4">Meet Augie</h2>
      <h3 class="au-statement type-h1">A face made of two brackets and two squares.</h3>
      <p class="au-prose type-body-md">The pill needs to say “listening” or “thinking” in 28 pixels. Augie, <code>[··]</code>, does it with keyframes. Its eyes follow your pointer.</p>

      <div class="au-states">
        {states.map(({ id, label, anim }) => (
          <figure class="au-state">
            <div class="au-state-stage"><div class="au-state-mascot" data-mascot={id}></div></div>
            <figcaption><strong class="type-h3">{label}</strong><span class="type-body-xs">{anim}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ── The pill ── -->
    <section id="pill" class="au-section" data-chapter="The notch">
      <h2 class="au-label type-h4">Out of the notch</h2>
      <h3 class="au-statement type-h1">The pill learned where it lives.</h3>
      <p class="au-prose type-body-md">A window would steal focus, so Augment shows a pill that never does. It took four tries.</p>

      <ol class="au-evolution">
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v1</span>
            <h3 class="type-h2">A floating pill</h3>
            <p class="au-prose type-body-sm">Translucent grey, attached to nothing.</p>
          </div>
          <figure class="au-shot au-shot--pill"><img src="/assets/augment/pill-v1-live.png" alt="The first mini pill: a translucent dark grey rounded pill over a wallpaper, showing the mascot, words being transcribed and a red timer" width="960" height="192" loading="lazy" /></figure>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v2</span>
            <h3 class="type-h2">Where it's going</h3>
            <p class="au-prose type-body-sm">Shows the app it's typing into.</p>
          </div>
          <div class="au-oldpill" aria-hidden="true">
            <div class="au-oldpill-slot" data-mascot="listening"></div>
            <span class="au-oldpill-text">Trip to Paris. Let's make <span>it a checklist.</span></span>
            <span class="au-oldpill-side">0:04</span>
            <img src="/assets/augment/icon-notes.png" alt="" width="24" height="24" />
          </div>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v3</span>
            <h3 class="type-h2">Out of the notch</h3>
            <p class="au-prose type-body-sm">Pure black, growing out of the MacBook notch, above the menu bar.</p>
          </div>
          <div class="au-desk au-desk--mini" data-au="notch" aria-hidden="true">
            <div class="au-menubar"><span class="au-menubar-left"><b></b>Notes<i>File</i><i>Edit</i></span><span class="au-menubar-right"><i>12:31</i></span></div>
            <div class="au-notch"></div>
            <div class="au-pill au-pill--one is-hidden">
              <div class="au-row">
                <div class="au-slot" data-mascot="listening"></div>
                <div class="au-text"><span class="au-line">Trip to Paris. Let's make <span class="au-tentative">it a checklist.</span></span></div>
                <span class="au-side au-rec">0:04</span>
                <img class="au-pill-icon" src="/assets/augment/icon-notes.png" alt="" width="20" height="20" />
              </div>
            </div>
          </div>
        </li>
        <li class="au-version">
          <div class="au-version-copy">
            <span class="au-version-num type-body-xs">v4</span>
            <h3 class="type-h2">Two rows, one job each</h3>
            <p class="au-prose type-body-sm">Words on top; where it went, below.</p>
          </div>
          <div class="au-desk au-desk--still" aria-hidden="true">
            <div class="au-notch"></div>
            <div class="au-pill">
              <div class="au-row">
                <div class="au-slot" data-mascot="idle"></div>
                <div class="au-text"><span class="au-line au-final">Trip to Paris ☐ Book flights ☐ Renew my passport ☐ Find a pet sitter</span></div>
              </div>
              <div class="au-bar">
                <span class="au-target"><img src="/assets/augment/icon-notes.png" alt="" width="18" height="18" />Notes</span>
                <span class="au-side">Pasted</span>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </section>

    <!-- ── Bugs ── -->
    <section id="bugs" class="au-section" data-chapter="What broke">
      <h2 class="au-label type-h4">What broke</h2>
      <div class="au-bugs">
        <div class="au-bug">
          <strong class="type-h3">The paste that never happened</strong>
          <p class="type-body-sm">I tuned prompts first. The logs showed Electron's clipboard API had changed, and every paste was failing silently.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">Permissions that vanished</strong>
          <p class="type-body-sm">Ad-hoc signing fingerprints each build, so macOS forgot permissions on every rebuild. A self-signed certificate fixed it.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">A shortcut someone else owned</strong>
          <p class="type-body-sm">Notes' ⇧⌘L opened another app's drawer, so Augment clicks Format → Checklist instead.</p>
        </div>
        <div class="au-bug">
          <strong class="type-h3">The close that snapped shut</strong>
          <p class="type-body-sm">Chromium won't restart an animation that only changes direction, so closing got its own keyframes.</p>
        </div>
      </div>
    </section>

    <!-- ── Next ── -->
    <section id="next" class="au-section" data-chapter="What's next">
      <h2 class="au-label type-h4">What's next</h2>
      <h3 class="au-statement type-h1">More small jobs, same rules.</h3>
      <p class="au-prose type-body-md">Each job is one module behind the router, so the next ones (a to-do list, a summary, an email draft) are small additions. The rule stays: the model decides, code checks, and when in doubt, do the safe thing.</p>
    </section>

  </article>
</Layout>

<script>
  import '../scripts/augment.js';
</script>

<style is:global>
  /* Everything is namespaced under .au: the live visuals are built by augment.js, and Astro's scoped styles wouldn't
     reach elements created at runtime. The product surfaces (the pill, Augie, the desk) keep the app's own colours in
     both themes; the page around them uses the site's tokens. */
  .au {
    max-width: 860px;
    padding: 80px clamp(24px, 8vw, 100px) 120px;
    --au-black: #000;
    --au-ink: #e6ebe4;
    --au-soft: #8e959a;
    --au-rec: #ef6270;
    --au-serif: ui-serif, "New York", Georgia, serif;
  }
  .au code { font-size: 0.92em; padding: 1px 5px; border-radius: 5px; background: var(--color-quote-bg); }
  .au-prose { max-width: 680px; line-height: 1.6; }
  .au-prose + .au-prose { margin-top: 12px; }

  /* ── Hero ── */
  .au-hero { display: flex; flex-direction: column; gap: 16px; margin-bottom: 48px; }

  /* ── The desk: a slice of a Mac with a notch, where the pill lives ── */
  .au-desk {
    --notch-h: 28px;
    --notch-w: 150px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background:
      radial-gradient(120% 90% at 85% 110%, #e08a5a 0%, transparent 55%),
      radial-gradient(90% 80% at 10% 0%, #4b3f9b 0%, transparent 60%),
      linear-gradient(160deg, #2f2a5c, #7a4d6f 60%, #c9785a);
  }
  .au-desk--hero { height: 440px; margin-top: 8px; }
  .au-desk--mini { height: 170px; }
  .au-desk--still { height: 168px; }
  .au-menubar {
    position: absolute; inset: 0 0 auto; height: var(--notch-h);
    display: flex; align-items: center; justify-content: space-between; padding: 0 14px;
    background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(12px);
    color: rgba(255, 255, 255, 0.92); font: 600 12px/1 var(--font-sans);
  }
  .au-menubar-left, .au-menubar-right { display: flex; align-items: center; gap: 14px; }
  .au-menubar i { font-style: normal; font-weight: 500; }
