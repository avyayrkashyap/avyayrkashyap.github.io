---
// src/pages/experiments.astro
import Layout from '../layouts/Layout.astro';
import { ThinkingOrb } from 'thinking-orbs';
import Work from '../components/Work.astro';

// Drawn as the homepage's Work rows. A cover is a phone holding a screen
// recording ('clip') or cycling through screenshots ('phone'); with neither,
// Work draws its own `video` cover, as Drinks I Sip shares the homepage's.
const apps = [
  {
    name: 'Points Are Really Bad',
    href: 'https://www.pointsarereallybad.com',
    blurb: 'Football score prediction game where points are really bad.',
    context: 'Inspired by Tifo Football, I built this game for me and my friends to get invested in every match. The closer we were to predicting the correct score, the fewer added points we got, and points are really bad.',
    layout: 'clip',
    clip: {
      src: '/assets/experiments/points-are-bad/points-are-bad.mp4',
      poster: '/assets/experiments/points-are-bad/points-are-bad-poster.png',
      alt: 'A run through the app: browsing fixtures, entering a score prediction, and locking it in.',
    },
  },
  {
    name: 'Trip Itinerary',
    href: 'https://avyayrk.com/trip-itinerary',
    blurb: 'Asynchronous trip planner that ensures the trip makes it out of the group chat.',
    context: 'I was going to go on a trip to New Orleans, but planning the itinerary with friends across timezones was tough - until I built Trip Itinerary, freeing us to coordinate asynchronously and have a well planned trip.',
    layout: 'phone',
    // Plan first: it's the one left showing under reduced motion
    shots: [
      { src: '/assets/experiments/trip-itinerary/plan.png', alt: 'The Plan tab of Trip Itinerary, showing a New Orleans trip laid out by day' },
      { src: '/assets/experiments/trip-itinerary/places.png', alt: 'The Places tab of Trip Itinerary' },
      { src: '/assets/experiments/trip-itinerary/people.png', alt: 'The People tab of Trip Itinerary' },
    ],
  },
  {
    name: 'Drinks I Sip',
    href: 'https://drinksisip.com',
    blurb: "A living list of the hot chocolates I've had in New York and Jersey City, with a map, a score and a cup of its own for every place.",
    video: '/assets/drinksisip/drinksisip-site.mp4',
    poster: '/assets/drinksisip/drinksisip-site-poster.jpg',
  },
].map((app) => ({
  ...app,
  title: `${app.name}.`,
  description: [app.blurb, app.context].filter(Boolean),
  external: true,
}));

// Dynamic Island mockups. An entry with no `src` renders as an empty slot, so
// adding another capture is a one-line change here.
const notifications = [
  {
    label: 'Live score',
    src: '/assets/experiments/dynamic-island/live-score.mp4',
    poster: '/assets/experiments/dynamic-island/live-score-poster.png',
    alt: 'A live football score running in the Dynamic Island, Manchester United against Manchester City',
  },
  {
    label: 'Wait for ride',
    src: '/assets/experiments/dynamic-island/uber-ride.mp4',
    poster: '/assets/experiments/dynamic-island/uber-ride-poster.png',
    alt: 'An Uber ride tracked in the Dynamic Island, with the car, plate and arrival time',
  },
];
---
<Layout title="Experiments — Avyay">
  <article class="exp">

    {/*
      ThinkingOrb paints grayscale ink only, so it gets recoloured by mapping
      every painted pixel onto the accent while keeping its alpha. Same
      approach as the hero orb: feColorMatrix can't read a CSS variable, so
      each theme carries its own filter and the wrapper swaps between them.
    */}
    <svg class="exp-orb-defs" aria-hidden="true" focusable="false">
      <!-- --color-accent light: #1A6CF0 -->
      <filter id="orbAccentLight" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0 0 0 0 0.10196
                  0 0 0 0 0.42353
                  0 0 0 0 0.94118
                  0 0 0 1 0" />
      </filter>
      <!-- --color-accent dark: #5C97FF -->
      <filter id="orbAccentDark" color-interpolation-filters="sRGB">
        <feColorMatrix
          type="matrix"
          values="0 0 0 0 0.36078
                  0 0 0 0 0.59216
                  0 0 0 0 1
                  0 0 0 1 0" />
      </filter>
    </svg>

    <header class="exp-intro">
      <span class="exp-orb" aria-hidden="true">
        <ThinkingOrb client:load state="composing" size={64} theme="light" aria-hidden={true} />
      </span>
      <h1 class="exp-title t-display t-display--sm" id="expTitle">My Sandbox to express random things.</h1>
    </header>

    <div class="exp-reveal">
      <Work label="Apps made with AI." projects={apps}>
        {(app) => app.layout && (
          <span class={`exp-phone${app.clip ? '' : ' exp-phone--slides'}`}>
            {app.clip ? (
              /* preload="none": nothing downloads until the clip scrolls
                 into view, and clips.js plays and pauses it from there */
              <video class="exp-clip" src={app.clip.src} poster={app.clip.poster} aria-label={app.clip.alt} preload="none" muted loop playsinline></video>
            ) : app.shots.map(({ src, alt }) => (
              <img class="exp-slide" src={src} alt={alt} loading="lazy" />
            ))}
          </span>
        )}
      </Work>
    </div>

    <section class="exp-section exp-reveal">
      <h2 class="exp-section-label">Really Live notifications.</h2>
      <div class="exp-videos">
        {notifications.map(({ label, src, poster, alt }) => (
          <figure class="exp-video">
            {src ? (
              /* Same deal as the app clips: nothing downloads until this
                 scrolls into view, then it plays and loops on its own. */
              <video
                class="exp-video-media exp-clip"
                src={src}
                poster={poster}
                aria-label={alt}
                preload="none"
                muted
                loop
                playsinline
              ></video>
            ) : (
              <div class="exp-video-placeholder" aria-hidden="true">
                <svg class="exp-video-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2.5" y="5" width="19" height="14" rx="3" />
                  <path d="M10 9.5 15 12l-5 2.5z" />
                </svg>
              </div>
            )}
            <figcaption class="exp-video-caption t-small">{label}</figcaption>
          </figure>
        ))}
      </div>
    </section>

  </article>
</Layout>

<script src="../scripts/experiments.js"></script>

<style>
  /* The homepage column: 934px, centred, with the same right gutter Hero and
     Work carry. Work brings its own; the intro and the notifications match. */
  .exp {
    padding-top: 48px;
  }

  .exp-intro,
  .exp-section {
    max-width: 934px;
    margin: 0 auto;
    padding-right: 24px;
    font-family: var(--font-ui);
  }

  /* Zero-size holder for the tint filters */
  .exp-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .exp-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-bottom: 64px;
  }

  .exp-orb {
    display: inline-flex;
    line-height: 0;
    filter: url(#orbAccentLight);
  }

  :global(html[data-theme='dark']) .exp-orb {
    filter: url(#orbAccentDark);
  }

  .exp-title {
    max-width: 18ch;
    transition: color 0.3s ease;
  }

  /* Caret only while the line is typing itself in */
  .exp-title.is-typing::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 0.85em;
    margin-left: 3px;
    vertical-align: -0.08em;
    background: var(--color-accent);
    animation: exp-caret 0.9s steps(1) infinite;
  }

  @keyframes exp-caret {
    50% { opacity: 0; }
  }

  /* ── App covers, drawn inside Work's 4:3 cover ── */
  /* A phone standing in the cover, run off its bottom edge by the cover's
     overflow */
  .exp-phone {
    position: absolute;
    top: 32px;
    left: 50%;
    height: 100%;
    /* Shorter than the clip's 296 x 640, which crops the recording's iOS
       status bar and dynamic island off the top */
    aspect-ratio: 296 / 584;
    padding: 7px;
    border-radius: 34px;
    /* Fixed rather than themed: this is a device, not a surface */
    background: #0B0C0F;
    box-shadow: 0 18px 40px var(--color-shadow), 0 2px 8px var(--color-shadow-soft);
    transform: translateX(-50%);
  }

  .exp-clip {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 27px;
    object-fit: cover;
    object-position: center bottom;
  }

  /* Screenshots stacked in the phone, each fading in for 3s of a 9s loop.
     Three of them: a fourth needs the loop and the delays stretched. */
  /* The screenshots' own shape, so their sides aren't cropped. Contain takes
     up the last few pixels the 7px bezel leaves, against the black glass. */
  .exp-phone--slides {
    aspect-ratio: 870 / 1532;
  }

  .exp-slide {
    position: absolute;
    inset: 7px;
    width: calc(100% - 14px);
    height: calc(100% - 14px);
    border-radius: 27px;
    object-fit: contain;
    object-position: center top;
    opacity: 0;
    animation: exp-slide 9s infinite;
  }

  .exp-slide:nth-child(2) { animation-delay: 3s; }
  .exp-slide:nth-child(3) { animation-delay: 6s; }

  @keyframes exp-slide {
    0% { opacity: 0; }
    6%, 33% { opacity: 1; }
    39%, 100% { opacity: 0; }
  }

  /* ── Really Live notifications ── */
  .exp-section {
    padding-bottom: 120px;
  }

  /* Work's label */
  .exp-section-label {
    margin-bottom: 16px;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-text-strong);
  }

  .exp-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .exp-video {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* The two captures sit at slightly different ratios, so the frame takes a
     ratio between them and the video is contained rather than cropped. The
     mockups are already black to the edges, so the letterboxing that leaves
     is invisible against the frame. */
  .exp-video-media,
  .exp-video-placeholder {
    width: 100%;
    aspect-ratio: 1.28;
    border-radius: 20px;
    background: #000;
    object-fit: contain;
  }

  .exp-video-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-accent);
  }

  .exp-video-glyph {
    width: 32px;
    height: 32px;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .exp-videos {
      grid-template-columns: minmax(0, 1fr);
    }

    .exp-title {
      max-width: none;
    }
  }

  /* Work's phone gutter */
  @media (max-width: 640px) {
    .exp-intro,
    .exp-section {
      padding-left: 16px;
      padding-right: 16px;
    }

    .exp-section {
      padding-bottom: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-title.is-typing::after,
    .exp-slide {
      animation: none;
    }

    .exp-slide:first-child {
      opacity: 1;
    }
  }
</style>
