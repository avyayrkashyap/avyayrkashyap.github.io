---
// src/components/Footer.astro
---
<footer class="site-footer">
  <div class="footer-contact">
    {/* At Title size the address is wider than a phone; <wbr> lets it wrap after the @ instead of overflowing */}
    <a class="footer-email type-title" href="mailto:avyayrk@gmail.com">avyayrk@<wbr />gmail.com</a>
    <span class="footer-caption type-body-xs">Get in touch</span>
  </div>

  <p class="footer-bottom type-body-xs">Made with <span aria-hidden="true">❤️</span> from New York, NY&nbsp;|&nbsp;Avyay Ravi Kashyap © 2026</p>
</footer>

<style>
  .site-footer {
    padding: 64px clamp(40px, 9vw, 122px) 48px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    border-top: 1px solid var(--color-border);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-email {
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-email:hover {
    color: var(--color-text-accent);
  }
</style>
