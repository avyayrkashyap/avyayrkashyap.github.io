---
// src/components/ResumeContent.astro
// The Resume page: an embedded PDF viewer, just the page itself. The
// #toolbar=0 fragment hides Chrome/Firefox's own PDF toolbar (zoom, print,
// page thumbnails); Safari mostly ignores it and shows its own controls
// regardless. A download link covers every browser either way, styled as the
// homepage's Paper "Link Button".
const PDF_SRC = '/assets/files/resume.pdf';
---
<div class="resume">
  <a class="resume-download" href={PDF_SRC} download>
    <span class="resume-download-diamond" aria-hidden="true"></span>Download resume.
  </a>
  <iframe class="resume-frame" src={`${PDF_SRC}#toolbar=0&navpanes=0&scrollbar=0`} title="Avyay Kashyap's resume"></iframe>
</div>

<style>
  /* Fills the viewport, so the PDF scrolls inside its own frame */
  .resume {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding-top: 24px;
    box-sizing: border-box;
  }

  @media (max-width: 640px) {
    .resume {
      height: calc(100dvh - var(--mobile-bar));
    }
  }

  /* The homepage's Paper "Link Button" (Work.astro .work-view): a diamond
     and a full-stop label; on hover both go blue and the diamond squares up */
  .resume-download {
    flex-shrink: 0;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin: 0 24px 16px;
    font-size: 16px;
    color: var(--color-text-strong);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .resume-download-diamond {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    background: currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .resume-download:hover {
    color: var(--color-text-accent);
  }

  .resume-download:hover .resume-download-diamond {
    transform: rotate(90deg);
  }

  .resume-download:focus-visible {
    outline: 2px solid var(--color-accent-outline);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-download,
    .resume-download-diamond {
      transition: none;
    }
  }

  .resume-frame {
    flex: 1;
    min-height: 0;
    width: 100%;
    border: 0;
    background: var(--color-bg-secondary);
  }
</style>
