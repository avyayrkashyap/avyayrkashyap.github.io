---
// src/components/CaseStudyCard.astro
interface Props {
  index: string;
  title: string;
  description: string;
  tags: string[];
  href: string;
  image?: string;
  imageAlt?: string;
  imageBg?: string;
  frameMaxWidth?: string;
  transitionName?: string;
}

const { index, title, description, tags, href, image, imageAlt = '', imageBg, frameMaxWidth, transitionName } = Astro.props;
---
<a href={href} class="case-study-link">
  <article class="case-study-card">
    <div class="cs-frame" style={{ background: imageBg, maxWidth: frameMaxWidth }}>
      <slot>
        {image && <img src={image} alt={imageAlt} class="cs-cover-img" transition:name={transitionName} />}
      </slot>
    </div>
    <div class="case-study-header">
    <div class="case-study-header-top">
      <span class="case-study-index t-label">{index}</span>
      <div class="case-study-tags t-label">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>
      <div class="case-study-info">
        <h2 class="case-study-title t-h2">{title}</h2>
        <p class="case-study-desc t-body">{description}</p>
      </div>
    </div>
  </article>
</a>

<style>
  .case-study-link {
    display: block;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .case-study-link.cs-revealed {
    opacity: 1;
    transform: none;
  }

  .case-study-link:nth-of-type(2) { transition-delay: 0.1s; }
  .case-study-link:nth-of-type(3) { transition-delay: 0.2s; }
  .case-study-link:nth-of-type(4) { transition-delay: 0.3s; }

  .cs-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 2.43;
    border-radius: 4px;
    overflow: hidden;
    transition: border-radius 0.4s ease;
  }

  .cs-frame:hover {
    translate: 0 -4px 0.4s ease-in-out;
  }

  .case-study-link:hover .cs-frame {
    border-radius: 16px;
  }

  .cs-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .case-study-link:hover .cs-cover-img {
    transform: scale(1.02);
  }

  .case-study-header-top {
    display: flex;
    justify-content: start;
    align-items: center;
    gap: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-frame,
    .cs-cover-img {
      transition: none;
    }

    .case-study-link {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
