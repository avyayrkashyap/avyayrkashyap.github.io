---
// src/components/CaseStudySection.astro
// A labelled block inside a case study theme: heading, copy, and one visual.
interface Props {
  label: string;
  body: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const { label, body, image, imageAlt = '', imageWidth, imageHeight } = Astro.props;
const id = label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<section class="cs-block" id={id}>
  <div class="cs-block-header">
    <h4 class="cs-block-title type-h2">{label}</h4>
    <p class="cs-block-body cs-prose type-body-md">{body}</p>
  </div>
  {image && (
    <div class="cs-block-visual">
      <img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} />
    </div>
  )}
</section>

<style>
  .cs-block {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 48px;
  }

  .cs-block-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* Long-form running text. The body primitives are set at line-height 1.3,
     which suits the UI-length copy they were drawn for; a case study
     paragraph runs ten lines, so it relaxes the leading and holds a measure.
     Family, size and colour still come from .type-body-md. */
  .cs-prose {
    max-width: 680px;
    line-height: 1.6;
  }

  /* Matches the card radius in the primitives */
  .cs-block-visual {
    border-radius: 12px;
    overflow: hidden;
  }

  .cs-block-visual img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
