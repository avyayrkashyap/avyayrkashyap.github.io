---
// src/components/PasswordGate.astro
// Client-side only — there's no backend on this static site, so this is a
// soft gate (keeps casual visitors and search engines out) rather than
// real security. The password is hashed (SHA-256) so it's not sitting in
// plain text in the page source; check happens in gate.js.
import { ThinkingOrb } from 'thinking-orbs';

interface Props {
  passwordHash: string;
  storageKey: string;
}

const { passwordHash, storageKey } = Astro.props;
---
<section class="gate" id="passwordGate" data-password-hash={passwordHash} data-storage-key={storageKey}>
  <svg class="gate-orb-defs" aria-hidden="true" focusable="false">
    <filter id="orbAccentLight" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.10196
                0 0 0 0 0.42353
                0 0 0 0 0.94118
                0 0 0 1 0" />
    </filter>
    <filter id="orbAccentDark" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36078
                0 0 0 0 0.59216
                0 0 0 0 1
                0 0 0 1 0" />
    </filter>
  </svg>

  <span class="gate-orb" aria-hidden="true">
    <ThinkingOrb client:load state="working" size={64} theme="light" aria-hidden={true} />
  </span>
  <h1 class="gate-title t-display">This one's locked.</h1>
  <p class="gate-note t-body">This case study isn't public yet. Enter the password to view it.</p>

  <form class="gate-form" id="gateForm" autocomplete="off">
    <input
      type="password"
      class="gate-input"
      id="gateInput"
      name="password"
      placeholder="Password"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
    />
    <button type="submit" class="gate-submit">Unlock</button>
  </form>
  <p class="gate-error t-small" id="gateError" hidden>That's not it — try again.</p>

  <a class="gate-back" href="/">← Back home</a>
</section>

<script src="../scripts/password-gate.js"></script>

<style>
  .gate {
    min-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    gap: 16px;
  }

  .gate[hidden] {
    display: none;
  }

  .gate-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .gate-orb {
    display: inline-flex;
    line-height: 0;
    filter: url(#orbAccentLight);
    margin-bottom: 8px;
  }

  :global(html[data-theme='dark']) .gate-orb {
    filter: url(#orbAccentDark);
  }

  .gate-title {
    transition: color 0.3s ease;
  }

  .gate-note {
    max-width: 40ch;
    transition: color 0.3s ease;
  }

  .gate-form {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
  }

  .gate-input {
    height: 42px;
    padding: 0 18px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 14px;
    width: 200px;
    transition: border-color 0.2s ease, background-color 0.3s ease, color 0.3s ease;
  }

  .gate-input::placeholder {
    color: var(--color-text-muted);
  }

  .gate-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .gate-submit {
    height: 42px;
    padding: 0 20px;
    border-radius: 9999px;
    border: none;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .gate-submit:hover {
    opacity: 0.85;
  }

  .gate-back {
    margin-top: 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .gate-back:hover {
    opacity: 1;
  }

  @keyframes gate-shake {
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }

  .gate-form.gate-form--shake {
    animation: gate-shake 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .gate-form.gate-form--shake {
      animation: none;
    }
  }
</style>
