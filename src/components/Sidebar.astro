---
// src/components/Sidebar.astro
const pathname = Astro.url.pathname;

const navItems = [
  { label: 'Home',        href: '/',            idx: 0 },
  { label: 'About',       href: '/about',       idx: 1 },
  { label: 'Experiments', href: '/experiments', idx: 2 },
  { label: 'Now',         href: '/now',         idx: 3 },
];

// Case-study sub-nav: a flat list of anchors, optionally nested one level
// deep via `children`. Keyed by the route prefix that should show it.
const caseStudySections: Record<string, { label: string; href: string; children?: { label: string; href: string }[] }[]> = {
  '/gep': [
    { label: 'Overview',         href: '#overview' },
    { label: 'Business Impact',  href: '#impact' },
    { label: 'Final Design',     href: '#final-design' },
    { label: 'Domain Research',  href: '#domain-research' },
    { label: 'Stakeholders',     href: '#stakeholders' },
    { label: 'Problem',          href: '#problem-statement' },
    { label: 'Process',          href: '#process' },
    { label: 'Learnings',        href: '#learnings' },
  ],
  '/moodys': [
    {
      label: 'Building Swan from 0 → 1',
      href: '#building-swan',
      children: [
        { label: 'Introduction',    href: '#introduction' },
        { label: 'Waterfall',       href: '#waterfall' },
        { label: 'Dashboards',      href: '#dashboards' },
        { label: 'Reference Rate',  href: '#reference-rate' },
        { label: 'Autorun',         href: '#autorun' },
      ],
    },
    {
      label: 'Translating single deal interactions into Portfolios',
      href: '#portfolio',
      children: [
        { label: 'Discovery & Research', href: '#discovery-research' },
        { label: 'Defining Individual vs Bulk Defaults', href: '#defining-individual-vs-bulk-defaults' },
        { label: 'Toolbar Definition', href: '#toolbar-definition' },
        { label: 'Bulk Edit', href: '#bulk-edit' },
      ],
    },
  ],
};

const activeCaseStudy = Object.keys(caseStudySections).find((key) => pathname.startsWith(key));
const isCaseStudy = activeCaseStudy !== undefined;
const subnavLinks = activeCaseStudy
  ? caseStudySections[activeCaseStudy].flatMap((s) => [
      { label: s.label, href: s.href, isChild: false },
      ...(s.children ?? []).map((c) => ({ ...c, isChild: true })),
    ])
  : [];
---

<aside class={`sidebar${isCaseStudy ? ' has-subnav' : ''}`}>
  <!-- Logo: 9 pill/circle shapes from design -->
  <div class="logo">
    <!-- circles -->
    <div class="logo-dot" style="--i: 0; --l: 0px; --t: 22px;"></div>
    <div class="logo-dot" style="--i: 1; --l: 43px; --t: 15px;"></div>
    <div class="logo-dot" style="--i: 2; --l: 84px; --t: 15px;"></div>
    <div class="logo-dot" style="--i: 3; --l: 64px; --t: 23px;"></div>
    <!-- long pills -->
    <div class="logo-dot" style="--i: 4; --h: 32px; --tr: 8px 4px; --r: 330deg; --rt: 360deg;"></div>
    <div class="logo-dot" style="--i: 5; --h: 32px; --tr: 58px 14px; --r: 30deg;"></div>
    <div class="logo-dot" style="--i: 6; --h: 32px; --tr: 99px 14px; --r: 30deg;"></div>
    <!-- short pills -->
    <div class="logo-dot" style="--i: 7; --h: 16px; --tr: 30px 18px; --r: 330deg; --rt: 360deg;"></div>
    <div class="logo-dot" style="--i: 8; --h: 16px; --tr: 85px 28px; --r: 150deg;"></div>
  </div>

  <!-- Scrollable nav region: everything between the logo and the theme
       toggle lives here, so it scrolls as one unit instead of clipping when
       a case study's sub-nav content grows taller than the sidebar. -->
  <div class="sidebar-scroll">
    <!-- Nav: tick field + labels -->
    <nav class="sidebar-nav" id="sidebarNav" data-subnav={isCaseStudy ? 'true' : 'false'}>
      <div class="tick-field" id="tickField"></div>
      {navItems.map(item => (
        <a
          href={item.href}
          class={`nav-link${pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) ? ' active' : ''}`}
          data-idx={item.idx}
        >{item.label}</a>
      ))}
    </nav>

    {isCaseStudy && (
      <nav class="cs-subnav" id="csSubnav">
        {subnavLinks.map(s => (
          <a href={s.href} class={`cs-subnav-link${s.isChild ? ' cs-subnav-link--child' : ''}`}>{s.label}</a>
        ))}
      </nav>
    )}
  </div>

  <button class="theme-toggle" id="themeToggle" role="switch" aria-checked="false" aria-label="Toggle dark mode">
    <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <line x1="12" y1="2" x2="12" y2="4" />
      <line x1="12" y1="20" x2="12" y2="22" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="2" y1="12" x2="4" y2="12" />
      <line x1="20" y1="12" x2="22" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
    <span class="theme-track" aria-hidden="true">
      <span class="theme-thumb"></span>
    </span>
    <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  </button>
</aside>

<script src="../scripts/sidebar.js"></script>
