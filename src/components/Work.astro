---
// src/components/Work.astro
import CaseStudyCard from './CaseStudyCard.astro';
---
<section id="work" class="work-section">
  <div class="work-list">
    <CaseStudyCard
      index="/01"
      title="Moody's Ratings"
      description="Led end-to-end design for Moody's first structured finance applications, reducing analyst errors by up to 33% and improving clarity of tools in a 0→1 enterprise environment."
      tags={["Product Design", "AI-assisted development", "Sep 2024 - Present"]}
      href="/moodys"
      image="/assets/moodys/moodys-cover.png"
      imageAlt="Moody's Structured Workflow Analytics dashboard"
      imageBg="#091264"
      transitionName="moodys-cover"
    />

    <hr class="work-divider" />

    <CaseStudyCard
      index="/02"
      title="GEP Cost Analytics"
      description="Bridged the gap between market volatility and strategic action by redesigning a cost analytics platform that increased product stickiness and user likability by 16%."
      tags={["Internship", "Product Design", "3 months"]}
      href="/gep"
      image="/assets/gep/gep-cover.png"
      imageAlt="GEP Cost Model dashboard"
      imageBg="#001E4F"
    />
  </div>
</section>

<script src="../scripts/reveal.js"></script>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-divider {
    border: none;
    border-top: 1px solid var(--color-divider);
    margin: 80px 0;
    transition: border-color 0.3s ease;
  }
</style>
