---
// src/components/Work.astro
// The projects section, from the "Work." group on the Paper "projects"
// artboard: a square cover with the title, summary, tags and a "View work."
// link beside it. Each project is one row, and the whole row is the link.
// Below 960px the text drops under the cover.
import Shapes from './Shapes.astro';

interface Project {
  title: string;
  description: string;
  tags: string[];
  href: string;
  external?: boolean;
  /* A screenshot cover; without one the project draws its own (Moody's) */
  image?: string;
}

const projects: Project[] = [
  {
    title: "Moody's Ratings.",
    description: 'Two years as a Senior UX Designer in Moody’s structured finance group: designing new tools from scratch, scaling them, contributing to the design system and shipping front-ends with AI-assisted code.',
    tags: ['Enterprise Systems.', 'Agentic Design.'],
    href: '/moodys-role',
  },
  {
    title: 'Augment.',
    description: "Designed and built a first step toward a personal agent for the Mac: talk anywhere, and Augment works out whether to type it where you're working, answer it, search it, or show the weather or a score. Whisper and Llama run on the laptop; Augment's only web lookups are forecasts and scores.",
    tags: ['Personal Agent.', 'macOS.'],
    href: '/augment',
    image: '/assets/augment/augment-cover.png',
  },
  {
    title: 'Cost Analytics.',
    description: 'Bridged the gap between market volatility and strategic action by redesigning a cost analytics platform that increased product stickiness and user likability by 16%.',
    tags: ['Enterprise Systems.', 'Data Visualisation.'],
    href: '/gep',
    image: '/assets/gep/gep-cover.png',
  },
  {
    title: 'Drinks I sip.',
    description: "My digital shelf of some cups and glasses I've liked enough to draw.",
    tags: ['Side Project.', 'Illustration.'],
    href: 'https://drinksisip.com',
    external: true,
    image: '/assets/experiments/drinksisip/drinksisip.png',
  },
];
---
<section id="work" class="work">
  <h2 class="work-label">Work.</h2>

  <div class="work-list">
    {projects.map(({ title, description, tags, href, external, image }) => (
      <a class="work-row" href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
        <div class="work-cover">
          {image ? (
            <img class="work-shot" src={image} alt="" loading="lazy" />
          ) : (
            <>
              {/* The Moody's cover, as drawn in Paper: the logo top left and
                  the 0 → 1 → n diagram across the middle */}
              <img class="work-logo work-logo-light" src="/assets/index/logo-moodys.png" alt="Moody's" />
              <img class="work-logo work-logo-dark" src="/assets/index/logo-moodys-dark.png" alt="" />
              <div class="work-sketch">
                <Shapes kind="zero-one-n" label="Diagram: an empty circle becomes a filled one, then a cluster" />
              </div>
            </>
          )}
        </div>

        <div class="work-text">
          <div class="work-summary">
            <h3 class="work-title">{title}</h3>
            <p class="work-desc">{description}</p>
            <ul class="work-tags">
              {tags.map((tag) => <li class="work-tag">{tag}</li>)}
            </ul>
          </div>
          <span class="work-view"><span class="work-diamond" aria-hidden="true"></span>View work.</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  /* Centred in the content column, like the hero above it */
  .work {
    max-width: 934px;
    margin: 0 auto;
    padding: 0 24px 120px 0;
    font-family: var(--font-ui);
    line-height: 1.3;
  }

  .work-label {
    margin-bottom: 16px;
    font-size: 20px;
    font-weight: 400;
    color: var(--color-text-strong);
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .work-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .work-row:focus-visible {
    outline: 2px solid var(--color-accent-outline);
    outline-offset: 4px;
  }

  /* ── Cover ── */
  .work-cover {
    --shape-bg: var(--color-cool-bg);
    position: relative;
    flex: 0 1 680px;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-cool-bg);
  }

  .work-shot {
    position: absolute;
    inset: 32px;
    width: calc(100% - 64px);
    height: calc(100% - 64px);
    object-fit: contain;
  }

  /* Positions are the Paper cover's, as fractions of its 680px side */
  .work-logo {
    position: absolute;
    left: 4.7%;
    top: 4.7%;
    width: 17.6%;
    height: auto;
  }

  .work-logo-dark {
    display: none;
  }

  :global(html[data-theme='dark']) .work-logo-light {
    display: none;
  }

  :global(html[data-theme='dark']) .work-logo-dark {
    display: block;
  }

  .work-sketch {
    position: absolute;
    left: 14.3%;
    top: 31.1%;
    width: 71.3%;
  }

  /* ── Text ── */
  .work-text {
    flex: 0 0 222px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .work-summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .work-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-strong);
  }

  .work-desc {
    font-size: 12px;
    color: var(--color-text-strong);
  }

  .work-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    list-style: none;
  }

  .work-tag {
    padding: 4px;
    font-size: 12px;
    background: var(--color-tag-bg);
    color: var(--color-text-secondary);
  }

  .work-view {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 16px;
    color: var(--color-text-strong);
    transition: color 0.2s ease;
  }

  .work-diamond {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    background: var(--color-text-strong);
    transform: rotate(45deg);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .work-row:hover .work-view {
    color: var(--color-text-accent);
  }

  /* The Paper "Link Button" hover: blue, and the diamond turns square */
  .work-row:hover .work-diamond {
    background: var(--color-text-accent);
    transform: rotate(90deg);
  }

  /* Stacked: the cover takes the column, the text sits under it */
  @media (max-width: 960px) {
    .work-row {
      flex-direction: column;
      gap: 16px;
    }

    .work-cover {
      flex: none;
      width: 100%;
    }

    .work-text {
      flex: none;
      gap: 16px;
      max-width: 480px;
    }
  }

  @media (max-width: 640px) {
    .work {
      padding: 0 16px 80px;
    }
  }
</style>
