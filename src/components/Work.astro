---
// src/components/Work.astro
import CaseStudyCard from './CaseStudyCard.astro';
import MoodysCover from './MoodysCover.astro';
---
<section id="work" class="work-section">
  <div class="work-list">
    <CaseStudyCard
      index="/01"
      title="Structured Finance 0→1"
      description="Led end-to-end design for a leading rating agency's first structured finance applications, reducing analyst errors by up to 33% and improving clarity of tools in a 0→1 enterprise environment."
      tags={["Product Design", "AI-assisted development", "Sep 2024 - Present"]}
      href="/moodys"
      imageBg="#091264"
    >
      <MoodysCover />
    </CaseStudyCard>

    <hr class="work-divider" />

    <CaseStudyCard
      index="/02"
      title="GEP Cost Analytics"
      description="Bridged the gap between market volatility and strategic action by redesigning a cost analytics platform that increased product stickiness and user likability by 16%."
      tags={["Internship", "Product Design", "3 months"]}
      href="/gep"
      image="/assets/gep/gep-cover.png"
      imageAlt="GEP Cost Model dashboard"
      imageBg="#001E4F"
    />

    <hr class="work-divider" />

    <CaseStudyCard
      index="/03"
      title="Leveraging AI in Enterprise"
      description="Used LLMs to close the distance between an idea and a working interface: playgrounds for business collaboration, front-end delivery that improved dev turnaround 3x, and skills that let non-designers run design decisions themselves."
      tags={["Product Design", "Agentic workflows", "Ongoing"]}
      href="/ai-in-enterprise"
      imageBg="#101828"
    />
  </div>
</section>

<script src="../scripts/reveal.js"></script>

<style>
  .work-list {
    display: flex;
    flex-direction: column;
  }

  .work-divider {
    border: none;
    border-top: 1px solid var(--color-divider);
    margin: 80px 0;
    transition: border-color 0.3s ease;
  }
</style>
