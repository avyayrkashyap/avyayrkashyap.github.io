---
// src/components/Dock.astro
// Site-wide primary navigation, fixed to the bottom of the viewport.
import ChapterPill from './ChapterPill.astro';
import ChapterSheet from './ChapterSheet.astro';

interface Props {
  /* Starts at the top, for pages that render with the sheet open */
  top?: boolean;
}

const { top = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Now', href: '/now' },
  { label: 'Resume', href: '/resume' },
];

const isActive = (href: string) => pathname === href;
// The label the collapsed mobile bar carries. Case study pages aren't in the
// nav at all, so they fall back to "Menu". dock.js keeps this in step when an
// open sheet makes a nav page current without a navigation.
const currentLabel = navItems.find(({ href }) => isActive(href))?.label ?? 'Menu';

const socials = [
  { label: 'X', href: 'https://x.com/avyayrkashyap', src: '/assets/index/dock-x.png', width: 18, invertDark: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/avyay-kashyap-4236635b/', src: '/assets/index/dock-linkedin.png', width: 16 },
  { label: 'Substack', href: 'https://avyaykashyap.substack.com/', src: '/assets/index/dock-substack.png', width: 16, zoom: true },
];
---
<div class:list={['dock', { 'dock--top': top }]} id="dock">
  <div class="dock-pill dock-pill--left">
    <button class="dock-theme" id="dockThemeToggle" role="switch" aria-checked="false" aria-label="Toggle dark mode">
      <svg class="dock-theme-icon dock-theme-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <line x1="12" y1="2" x2="12" y2="4" />
        <line x1="12" y1="20" x2="12" y2="22" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="2" y1="12" x2="4" y2="12" />
        <line x1="20" y1="12" x2="22" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
      <span class="dock-track" aria-hidden="true"><span class="dock-thumb"></span></span>
      <svg class="dock-theme-icon dock-theme-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
  </div>

  {/* Two groups, and which one is a box depends on the breakpoint. On desktop
      both are display: contents, so every link, the chapter pill and the menu
      button lay out inline in the nav exactly as if these wrappers weren't
      here. On phones each becomes a sheet of its own: the links above, the
      chapter list and its pill below, with a gap between them. */}
  <nav class="dock-nav" id="dockNav" aria-label="Primary">
    <div class="dock-links">
      {navItems.map(({ label, href }) => (
        <a
          class={`dock-link${isActive(href) ? ' is-active' : ''}`}
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
        >{label}</a>
      ))}
    </div>

    <div class="dock-bar">
      {/* Mobile only, and stacked above the pill inside this same sheet, so
          the list reads as belonging to the chapter it names */}
      <ChapterSheet />
      <ChapterPill />
      {/* Mobile only: the collapsed bar's page label, which the chapter pill
          replaces on pages that have chapters */}
      <span class="dock-current" id="dockCurrent" aria-hidden="true">{currentLabel}</span>
      {/* Mobile only: expands both sheets */}
      <button class="dock-menu" id="dockMenu" type="button" aria-expanded="false" aria-controls="dock" aria-label="Open menu">
        <span class="material-symbols-outlined" aria-hidden="true">apps</span>
      </button>
    </div>

    <span class="dock-indicator" id="dockIndicator" aria-hidden="true"></span>
  </nav>

  <div class="dock-pill dock-pill--right">
    {socials.map(({ label, href, src, width, invertDark, zoom }) => (
      <a class="dock-social" href={href} target="_blank" rel="noopener" aria-label={label}>
        <span
          class:list={['dock-social-icon', { 'dock-social-icon--invert': invertDark, 'dock-social-icon--zoom': zoom }]}
          style={`width: ${width}px; background-image: url(${src});`}
          aria-hidden="true"
        ></span>
      </a>
    ))}
  </div>
</div>

<script src="../scripts/dock.js"></script>

<style>
  /* ── Dock ── */
  .dock {
    position: fixed;
    z-index: 50;
    left: 50%;
    /* 40px from the viewport edge lines it up inside the homepage hero card */
    bottom: 40px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
  }

  /* While a sheet is open. sheet.js animates the move between the two anchors. */
  .dock.dock--top {
    top: 16px;
    bottom: auto;
  }

  .dock-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    background-color: rgba(255, 255, 255, 0.4);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Side pills tuck 4px under the nav so it reads as one raised key */
  .dock-pill--left {
    padding-right: 8px;
    margin-right: -4px;
    border-radius: 8px 0 0 8px;
  }

  .dock-pill--right {
    padding-left: 8px;
    margin-left: -4px;
    border-radius: 0 8px 8px 0;
  }

  /* With a mouse, the side pills hide behind the nav and slide out when the
     pointer enters the dock. Keyboard focus reveals them too. Touch screens
     have no hover, so they stay visible there. Phones use the menu sheet. */
  @media (min-width: 641px) and (hover: hover) and (pointer: fine) {
    .dock-pill {
      opacity: 0;
      pointer-events: none;
    }

    .dock-pill--left {
      transform: translateX(100%);
    }

    .dock-pill--right {
      transform: translateX(-100%);
    }

    .dock:hover .dock-pill,
    .dock:focus-within .dock-pill {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  :global(html[data-theme='dark']) .dock-pill {
    background-color: rgba(33, 34, 39, 0.4);
  }

  /* Phones draw the pills' surface with .dock::before instead (see below) */
  @media (min-width: 641px) {
    :global(html.sheet-open) .dock-pill {
      background-color: var(--color-bg-secondary);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .dock-theme {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 2px 4px;
    border: 0;
    border-radius: 4px;
    background: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  /* Same hover surface as the social links */
  .dock-theme:hover {
    background-color: var(--color-cool-bg);
  }

  .dock-theme-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    transition: color 0.3s ease;
  }

  .dock-theme-icon--sun {
    color: var(--color-text-accent);
  }

  .dock-theme-icon--moon {
    color: var(--color-text-muted);
  }

  :global(html[data-theme='dark']) .dock-theme-icon--sun {
    color: var(--color-text-muted);
  }

  :global(html[data-theme='dark']) .dock-theme-icon--moon {
    color: var(--color-text-accent);
  }

  .dock-track {
    position: relative;
    width: 34px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 9999px;
    background-color: var(--color-accent-soft);
  }

  .dock-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 9999px;
    background-color: #FFFFFF;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
  }

  :global(html[data-theme='dark']) .dock-thumb {
    transform: translateX(14px);
  }

  .dock-nav {
    position: relative;
    z-index: 1;
    display: flex;
    /* Vertical padding lives on each .dock-link instead, so the hit target
       fills the full pill height rather than just the text line */
    padding: 0;
    border-radius: 8px;
    /* Frosted glass: translucent fill blurs whatever scrolls underneath */
    background-color: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5), 0 1px 4px rgba(0, 0, 0, 0.2);
    transition: background-color 0.3s ease;
  }

  :global(html[data-theme='dark']) .dock-nav {
    background-color: rgba(33, 34, 39, 0.55);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  /* A sheet is up: glass over the sheet and scrim gets muddy, so go solid */
  :global(html.sheet-open) .dock-nav {
    background-color: var(--color-bg-secondary);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  /* Dissolved by default: the links, the chapter pill and the menu button are
     direct flex items of the nav, and only the mobile block below gives these
     two wrappers boxes of their own. */
  .dock-links,
  .dock-bar {
    display: contents;
  }

  /* DOM order is all four links, then the chapter pill — the grouping the
     mobile sheets need. Inline in the bar the pill belongs between About and
     Now, which is what these two rules restore. (order applies to the links
     themselves: with the wrappers dissolved, they're the flex items.) */
  .dock-links .dock-link:nth-child(n + 3) {
    order: 2;
  }

  .dock-link {
    width: 84px;
    flex-shrink: 0;
    /* 8px moved here from .dock-nav's old top/bottom padding */
    padding: 10px 0;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    color: var(--color-text-strong);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .dock-link:hover,
  .dock-link.is-active {
    color: var(--color-text-accent);
  }

  .dock-link:first-of-type {
    padding-left: 4px;
    border-radius: 8px 0 0 8px;
  }

  .dock-link:last-of-type {
    padding-right: 4px;
    border-radius: 0 8px 8px 0;
  }

  /* Same hover surface as the theme toggle and social links */
  .dock-link:hover {
    background-color: var(--color-cool-bg);
  }

  .dock-link.is-active {
    font-weight: 700;
  }

  .dock-menu,
  .dock-current {
    display: none;
  }

  .dock-indicator {
    position: absolute;
    left: 0;
    top: 32px;
    width: 16px;
    height: 2px;
    border-radius: 9999px;
    background-color: var(--color-text-accent);
    /* hero.js positions it under the active link, then follows hover */
    transform: translateX(36px);
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .dock-social {
    display: flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .dock-social:hover {
    background-color: var(--color-cool-bg);
  }

  .dock-social-icon {
    display: block;
    height: 16px;
    flex-shrink: 0;
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .dock-social-icon--zoom {
    background-size: 160%;
  }

  :global(html[data-theme='dark']) .dock-social-icon--invert {
    filter: invert(1);
  }

  /* ── Mobile: collapsed bar + expanding menu ── */
  @media (max-width: 640px) {
    .dock {
      bottom: 24px;
      width: 240px;
      display: grid;
      /* Equal outer tracks keep the theme + socials group centered whatever their
         widths. max-content, not auto: the pills clip overflow for their
         collapse animation, which lets auto tracks shrink below their content */
      grid-template-columns: 1fr max-content max-content 1fr;
    }

    /* The nav stops being a surface here and becomes the stack that holds
       two of them: the links sheet, then the chapter list and its pill. Each
       draws its own glass (see .dock-links, .dock-bar below), so the gap
       between them shows the page rather than more chrome. */
    .dock-nav {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      padding: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
    }

    :global(html[data-theme='dark']) .dock-nav,
    :global(html.sheet-open) .dock-nav {
      background: none;
      box-shadow: none;
    }

    /* The two sheets. Same glass the nav itself carries on desktop, each with
       its own edge highlight so they read as two separate surfaces. */
    .dock-links,
    .dock-bar {
      border-radius: 12px;
      background-color: rgba(255, 255, 255, 0.75);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      backdrop-filter: blur(16px) saturate(180%);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5), 0 1px 4px rgba(0, 0, 0, 0.2);
    }

    :global(html[data-theme='dark']) .dock-links,
    :global(html[data-theme='dark']) .dock-bar {
      background-color: rgba(33, 34, 39, 0.75);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 1px 4px rgba(0, 0, 0, 0.4);
    }

    :global(html.sheet-open) .dock-links,
    :global(html.sheet-open) .dock-bar {
      background-color: var(--color-bg-secondary);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    /* ── The links sheet, above ── */
    .dock-links {
      display: flex;
      flex-direction: column;
      /* The inset the rows' highlight leaves around itself; the rows carry
         the remaining 8px as padding, so their text still lands on the
         bar's 16px line */
      padding-inline: 8px;
      /* Collapsed to nothing, margin and padding animating alongside the
         height so it leaves no empty strip behind (the same treatment
         .dock-pill gets for the tray below) */
      max-height: 0;
      margin-bottom: 0;
      padding-block: 0;
      opacity: 0;
      overflow: hidden;
      visibility: hidden;
      transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1), margin 0.35s cubic-bezier(0.25, 1, 0.5, 1), padding 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.2s ease, visibility 0s 0.35s;
    }

    .dock.is-open .dock-links {
      max-height: 200px;
      /* The separation between the two sheets */
      margin-bottom: 8px;
      padding-block: 4px;
      opacity: 1;
      visibility: visible;
      transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1), margin 0.35s cubic-bezier(0.25, 1, 0.5, 1), padding 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.25s ease 0.05s, visibility 0s;
    }

    /* The current page is named on the bar below instead, so it isn't
       repeated in the list */
    .dock-links .dock-link.is-active {
      display: none;
    }

    /* ── The bar, below: the chapter list and the pill it belongs to ── */
    .dock-bar {
      position: relative;
      display: flex;
      flex-direction: column;
      /* Right side clears the absolutely positioned menu button */
      padding: 4px 44px 4px 16px;
    }

    /* With chapters, the chapter pill takes the bar row in the page label's
       place. chapters.js sets the class (rather than :has() on .chapter)
       because that element belongs to ChapterPill's scope, not this one. */
    .dock--chapters .dock-current {
      display: none;
    }

    .dock-indicator {
      display: none;
    }

    /* A row fills its sheet's content box, so its hover and active highlight
       runs the full width with an even 8px of sheet either side — rather than
       the old lopsided bleed, which sat 8px off the left edge and 16px off
       the right. The 8px of padding here is what keeps the label on the
       bar's 16px text line. */
    .dock-link,
    .dock-current {
      width: auto;
      padding: 10px 8px;
      border-radius: 6px;
      text-align: left;
    }

    /* A label rather than a control, so it has no highlight to inset — it
       sits straight on the bar's own 16px padding */
    .dock-current {
      display: block;
      padding: 6px 0;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.3;
      color: var(--color-text-accent);
    }

    /* Pinned to the bottom-right so it stays beside the bar row as the
       chapter list above it grows */
    .dock-menu {
      position: absolute;
      right: 4px;
      bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      flex-shrink: 0;
      border: 0;
      border-radius: 8px;
      background: none;
      color: var(--color-text-strong);
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .dock-menu .material-symbols-outlined {
      font-size: 22px;
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .dock.is-open .dock-menu {
      background-color: var(--color-accent-soft);
      color: var(--color-text-accent);
    }

    .dock.is-open .dock-menu .material-symbols-outlined {
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    /* Theme + socials: one sheet tucked under the nav, sliding out when open */
    .dock-pill {
      /* The tray surface (.dock::before) forms its own layer; positioning the
         pills paints them above it instead of underneath */
      position: relative;
      grid-row: 2;
      max-height: 0;
      margin: 0;
      padding-block: 0;
      opacity: 0;
      overflow: hidden;
      visibility: hidden;
      transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1), margin 0.35s cubic-bezier(0.25, 1, 0.5, 1), padding 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.2s ease, visibility 0s 0.35s;
    }

    /* One sheet surface drawn behind both halves, tucked under the nav. Denser
       frost than desktop since it sits over body text on phones. */
    .dock::before {
      content: '';
      grid-column: 1 / -1;
      grid-row: 2;
      /* The dock centers its items; the tray has no content, so it must stretch */
      align-self: stretch;
      margin-top: -12px;
      border-radius: 0 0 12px 12px;
      background-color: rgba(255, 255, 255, 0.75);
      -webkit-backdrop-filter: blur(16px) saturate(180%);
      backdrop-filter: blur(16px) saturate(180%);
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    :global(html[data-theme='dark']) .dock::before {
      background-color: rgba(33, 34, 39, 0.75);
    }

    :global(html.sheet-open) .dock::before {
      background-color: var(--color-bg-secondary);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .dock.is-open::before {
      opacity: 1;
    }

    .dock-pill,
    :global(html[data-theme='dark']) .dock-pill {
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-radius: 0;
    }

    .dock-pill--left {
      grid-column: 2;
      padding-inline: 0 8px;
    }

    .dock-pill--right {
      grid-column: 3;
      padding-inline: 8px 0;
    }

    .dock.is-open .dock-pill {
      max-height: 56px;
      margin-top: -12px;
      padding-block: 18px 6px;
      opacity: 1;
      visibility: visible;
      transition: max-height 0.35s cubic-bezier(0.25, 1, 0.5, 1), margin 0.35s cubic-bezier(0.25, 1, 0.5, 1), padding 0.35s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.25s ease 0.05s, visibility 0s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-thumb,
    .dock-indicator,
    .dock-pill,
    .dock-link {
      transition: none !important;
    }
  }
</style>
