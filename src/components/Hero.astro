---
// src/components/Hero.astro
import { ThinkingOrb } from 'thinking-orbs';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/avyaykashyap/' },
  { label: 'X', href: 'https://x.com/avyayrk' },
  { label: 'Resume', href: '/assets/files/resume.pdf' },
];
---
<section class="hero">
  {/*
    ThinkingOrb paints grayscale ink only (no colour prop), so the orb is
    recoloured by mapping every painted pixel to the accent blue while
    keeping its alpha. Lives on the wrapper because Astro's scoped styles
    don't reach elements rendered inside a React island.
  */}
  <svg class="hero-orb-defs" aria-hidden="true" focusable="false">
    <filter id="orbBlue" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.10196
                0 0 0 0 0.42353
                0 0 0 0 0.94118
                0 0 0 1 0" />
    </filter>
  </svg>

  <p class="hero-eyebrow">
    <span class="hero-orb" aria-hidden="true">
      <ThinkingOrb client:load state="breathing" size={20} theme="light" aria-hidden={true} />
    </span>
    Hi, I am Avyay
  </p>
  <h1 class="hero-title">Making Complex Experiences Intuitive</h1>
  <p class="hero-body">I'm detail oriented product builder, crafting familiar, yet novel experiences that enable critical thinking.</p>

  <div class="hero-links">
    {links.map(({ label, href }) => (
      <a class="hero-link" href={href} target="_blank" rel="noopener">
        {label}
        <svg class="hero-link-arrow" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3.5 8.5 8.5 3.5" />
          <path d="M4.25 3.5H8.5V7.75" />
        </svg>
      </a>
    ))}
  </div>
</section>

<style>
  .hero {
    padding: clamp(96px, 16vh, 168px) clamp(40px, 9vw, 122px) clamp(64px, 9vh, 104px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: #1A6CF0;
    margin-bottom: 14px;
  }

  /* Zero-size holder for the tint filter */
  .hero-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .hero-orb {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
    filter: url(#orbBlue);
  }

  /* Sized against the ~670px content column, not the viewport */
  .hero-title {
    font-family: 'Lexend', system-ui, sans-serif;
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #1C1C1E;
  }

  .hero-body {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: #1C1C1E;
    opacity: 0.65;
    max-width: 50ch;
    margin-top: 20px;
  }

  /* ── Link pills ── */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    background: #FFFFFF;
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(26, 108, 240, 0.06), 0 4px 16px rgba(26, 108, 240, 0.08);
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1C1C1E;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .hero-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 2px 4px rgba(26, 108, 240, 0.08), 0 8px 24px rgba(26, 108, 240, 0.14);
    color: #1A6CF0;
  }

  .hero-link-arrow {
    width: 12px;
    height: 12px;
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .hero-link:hover .hero-link-arrow {
    opacity: 1;
  }

  @media (max-width: 768px) {
    /* Horizontal padding stays in sync with .work-section so both align */
    .hero {
      padding-top: clamp(72px, 12vh, 112px);
      padding-bottom: 56px;
    }

    .hero-body {
      font-size: 16px;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-link,
    .hero-link-arrow {
      transition: none;
    }
    .hero-link:hover {
      transform: none;
    }
  }
</style>
