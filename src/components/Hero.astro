---
// src/components/Hero.astro
import { ThinkingOrb } from 'thinking-orbs';

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/avyaykashyap/' },
  { label: 'X', href: 'https://x.com/avyayrk' },
  { label: 'Resume', href: '/assets/files/resume.pdf' },
];
---
<section class="hero">
  {/*
    ThinkingOrb paints grayscale ink only (no colour prop), so the orb is
    recoloured by mapping every painted pixel to the accent while keeping
    its alpha. Lives on the wrapper because Astro's scoped styles don't
    reach elements rendered inside a React island. feColorMatrix can't read
    a CSS variable, so each theme's accent gets its own filter and the
    wrapper swaps between them.
  */}
  <svg class="hero-orb-defs" aria-hidden="true" focusable="false">
    <!-- --color-accent light: #1A6CF0 -->
    <filter id="orbAccentLight" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.10196
                0 0 0 0 0.42353
                0 0 0 0 0.94118
                0 0 0 1 0" />
    </filter>
    <!-- --color-accent dark: #5C97FF -->
    <filter id="orbAccentDark" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36078
                0 0 0 0 0.59216
                0 0 0 0 1
                0 0 0 1 0" />
    </filter>
  </svg>

  <p class="hero-eyebrow">
    <span class="hero-orb" aria-hidden="true">
      <ThinkingOrb client:load state="breathing" size={20} theme="light" aria-hidden={true} />
    </span>
    Hi, I am Avyay
  </p>
  <h1 class="hero-title">I make complexity intuitive through AI-native design processes that drive business impact.</h1>

  <div class="hero-logos">
    <img class="hero-logo hero-logo--light" src="/assets/index/logo-moodys.png" alt="Moody's" />
    <img class="hero-logo hero-logo--dark" src="/assets/index/logo-moodys-dark.png" alt="Moody's" />
    <span class="hero-logo-dot" aria-hidden="true"></span>
    <img class="hero-logo hero-logo--light" src="/assets/index/logo-gep.png" alt="GEP" />
    <img class="hero-logo hero-logo--dark" src="/assets/index/logo-gep-dark.png" alt="GEP" />
    <span class="hero-logo-dot" aria-hidden="true"></span>
    <img class="hero-logo" src="/assets/index/logo-jio.png" alt="Jio" />
    <span class="hero-logo-dot" aria-hidden="true"></span>
    <img class="hero-logo" src="/assets/index/logo-philips.png" alt="Philips" />
  </div>

  <div class="hero-links">
    {links.map(({ label, href }) => (
      <a class="hero-link" href={href} target="_blank" rel="noopener">
        {label}
        <svg class="hero-link-arrow" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3.5 8.5 8.5 3.5" />
          <path d="M4.25 3.5H8.5V7.75" />
        </svg>
      </a>
    ))}
  </div>
</section>

<style>
  .hero {
    padding: clamp(96px, 16vh, 168px) clamp(40px, 9vw, 122px) clamp(64px, 9vh, 104px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-eyebrow {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 8px;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-accent);
    margin-bottom: 14px;
    transition: color 0.3s ease;
  }

  /* Zero-size holder for the tint filters */
  .hero-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .hero-orb {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
    filter: url(#orbAccentLight);
  }

  :global(html[data-theme='dark']) .hero-orb {
    filter: url(#orbAccentDark);
  }

  /* Sized against the ~670px content column, not the viewport */
  .hero-title {
    font-family: 'Lexend', system-ui, sans-serif;
    font-size: clamp(28px, 3.6vw, 36px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.056em;
    color: var(--color-text);
    transition: color 0.3s ease;
  }

  /* ── Client logos ── */
  .hero-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 36px;
  }

  .hero-logo {
    height: 16px;
    width: auto;
    flex-shrink: 0;
  }

  /* Moody's, GEP, and Jio ship separate dark-mode marks; swap by theme
     instead of tinting so each keeps its intended brand color. */
  .hero-logo--dark {
    display: none;
  }

  :global(html[data-theme='dark']) .hero-logo--light {
    display: none;
  }

  :global(html[data-theme='dark']) .hero-logo--dark {
    display: block;
  }

  .hero-logo-dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  /* ── Link pills ── */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 16px;
    background: transparent;
    border-radius: 9999px;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .hero-link:hover {
    transform: translateY(-2px);
    background: var(--color-bg-secondary);
    color: var(--color-accent);
  }

  .hero-link-arrow {
    width: 12px;
    height: 12px;
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .hero-link:hover .hero-link-arrow {
    opacity: 1;
  }

  @media (max-width: 768px) {
    /* Horizontal padding stays in sync with .work-section so both align */
    .hero {
      padding-top: clamp(72px, 12vh, 112px);
      padding-bottom: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-link,
    .hero-link-arrow {
      transition: none;
    }
    .hero-link:hover {
      transform: none;
    }
  }
</style>
