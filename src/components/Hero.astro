---
// src/components/Hero.astro
// Backdrop photos; pixel-field.js reads each scene off its dot.
// horizon: waterline as a fraction of the photo's height.
// top: the row of the photo (fraction of its height) that sits at the top
// edge of the band when the photo is taller than the band; set just above the
// tallest tower so the skyline fills the frame.
// zoom (optional): crop in further than a plain cover, trimming the sides,
// for wide-angle shots whose buildings read small.
// hour: roughly when it was shot (0-24); the page opens on the photo closest
// to the visitor's local time.
const scenes = [
  { src: '/assets/index/hero-skyline.jpg', hour: 12, horizon: 0.572, top: 0.33, label: 'Central Park Reservoir, New York' },
  { src: '/assets/index/hero-hudson.jpg', hour: 20, horizon: 0.667, top: 0.21, label: 'Hudson River at dusk, Hoboken' },
  { src: '/assets/index/hero-brooklyn-bridge.jpg', hour: 14, horizon: 0.594, top: 0.42, zoom: 1.35, label: 'Brooklyn Bridge from the East River' },
];

// Draw mode pens; the first is selected
const pens = [
  { label: 'Blue', color: 'var(--color-text-accent)' },
  { label: 'Violet', color: '#8B5CF6' },
  { label: 'Red', color: 'var(--color-error)' },
];
---
<section class="hero">
  <!-- The greeting cycles through languages (script below) -->
  <p class="hero-hello"><span id="heroHello" lang="en">Hello</span>, I am Avyay.</p>

  <!-- The photo band: a pixelated New York photo with a hairline grid -->
  <div class="hero-card">
    <!-- Clipped from the bottom on hover, to make room for the bar -->
    <div class="hero-photo">
      <canvas class="hero-pixels" aria-hidden="true"></canvas>
      <div class="hero-grid" aria-hidden="true"></div>
      <!-- Draw mode (hero-draw.js): a plain surface over the photo, with a
           cursive hello that writes itself in -->
      <div class="hero-draw">
        <!-- The same strokes drawn wider and blurred, under the sharp ones -->
        <canvas class="hero-glow" aria-hidden="true"></canvas>
        <canvas class="hero-pad" aria-label="Drawing surface"></canvas>
        <svg class="hero-ink" viewBox="0 0 400 170" aria-hidden="true">
          <path pathLength="1" d="M20 142C48 122 88 72 94 42C98 22 82 14 73 34C62 60 58 110 56 150C62 120 80 101 96 101C112 101 113 120 110 136C108 148 118 153 131 145C151 134 172 121 170 108C168 96 148 98 144 115C140 135 152 152 172 150C190 148 205 135 215 120C231 95 245 50 240 30C236 15 220 20 218 40C215 70 212 120 222 145C230 156 248 150 258 135C272 110 290 55 285 32C281 16 264 22 262 42C259 72 256 122 266 146C274 157 292 150 302 138C312 120 325 104 340 102C325 102 314 118 318 135C322 152 345 154 354 138C362 122 355 102 340 102C350 98 365 100 385 96" />
        </svg>
      </div>
    </div>
    <!-- Revealed under the photo on hover (always shown on touch screens) -->
    <div class="hero-bar">
      <div class="hero-modes">
        <button class="hero-mode" type="button" data-mode="draw" aria-pressed="false">Draw.</button>
        <button class="hero-mode" type="button" data-mode="photos" aria-pressed="true">Photos.</button>
      </div>
      <!-- Draw mode only: wipe the surface, and pick a pen -->
      <div class="hero-pens" role="group" aria-label="Pen colour">
        <button class="hero-clear" type="button">Clear.</button>
        {pens.map((p, i) => (
          <button
            class="hero-pen"
            type="button"
            aria-label={p.label}
            aria-pressed={i === 0 ? 'true' : 'false'}
            style={`--pen: ${p.color}`}
          ></button>
        ))}
      </div>
      <div class="hero-dots" role="group" aria-label="Background photo">
      {scenes.map((s, i) => (
        <button
          class="hero-dot"
          type="button"
          aria-label={`Photo ${i + 1}: ${s.label}`}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-src={s.src}
          data-horizon={s.horizon}
          data-top={s.top}
          data-zoom={s.zoom ?? 1}
          data-hour={s.hour}
        ></button>
      ))}
      </div>
    </div>
  </div>

  <h1 class="hero-title">I solve problems that make every day better.</h1>
  <p class="hero-lead">I am a product designer and builder in New York who geeks out on how systems fit together. I make complex enterprise and AI tools feel obvious without flattening the complexity that makes them powerful, turning dense business processes into clear, intuitive flows through thought, care and craft.</p>
</section>

<script src="../scripts/pixel-field.js"></script>
<script src="../scripts/hero-draw.js"></script>

<script>
  // Greeting: types out each language in turn, morning/afternoon/evening by
  // the visitor's local time. [lang, morning, afternoon, evening]
  const GREETINGS = [
    ['en', 'Good morning', 'Good afternoon', 'Good evening'],
    ['it', 'Buongiorno', 'Buon pomeriggio', 'Buonasera'],
    ['en-US', "Mornin', y'all", "Afternoon, y'all", "Evenin', y'all"],
    ['kn', 'ಶುಭೋದಯ', 'ಶುಭ ಮಧ್ಯಾಹ್ನ', 'ಶುಭ ಸಂಜೆ'],
    ['hi', 'सुप्रभात', 'शुभ दोपहर', 'शुभ संध्या'],
    ['de', 'Guten Morgen', 'Guten Tag', 'Guten Abend'],
    ['fr', 'Bonjour', 'Bon après-midi', 'Bonsoir'],
  ];
  const TYPE_MS = 70, DELETE_MS = 40, HOLD_MS = 2200, GAP_MS = 250;

  // Before noon, before 5pm, otherwise evening
  const slot = () => { const h = new Date().getHours(); return h >= 5 && h < 12 ? 1 : h >= 5 && h < 17 ? 2 : 3; };
  // Kannada and Hindi build letters from combining marks, so type whole
  // graphemes rather than code units
  const seg = new Intl.Segmenter();
  const graphemes = (s: string) => [...seg.segment(s)].map((g) => g.segment);

  let timer: ReturnType<typeof setTimeout>;
  document.addEventListener('astro:before-swap', () => clearTimeout(timer));

  document.addEventListener('astro:page-load', () => {
    clearTimeout(timer);
    const el = document.getElementById('heroHello');
    if (!el) return;
    el.textContent = GREETINGS[0][slot()];
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let i = 0;
    const wait = (ms: number, fn: () => void) => { timer = setTimeout(fn, ms); };
    const erase = () => {
      const g = graphemes(el.textContent ?? '');
      if (g.length) {
        el.textContent = g.slice(0, -1).join('');
        return wait(DELETE_MS, erase);
      }
      i = (i + 1) % GREETINGS.length;
      el.lang = GREETINGS[i][0];
      wait(GAP_MS, () => type(graphemes(GREETINGS[i][slot()]), 1));
    };
    const type = (g: string[], n: number) => {
      el.textContent = g.slice(0, n).join('');
      if (n < g.length) wait(TYPE_MS, () => type(g, n + 1));
      else wait(HOLD_MS, erase);
    };
    wait(HOLD_MS, erase);
  });
</script>

<style>
  /* Left aligned in the content column, as in the Paper intro artboard,
     instead of centred like the other .main sections */
  .hero {
    max-width: 934px;
    margin: 0;
    padding: 48px 24px 72px 0;
    font-family: var(--font-ui);
    line-height: 1.3;
  }

  .hero-hello {
    margin: 0 0 16px;
    font-size: 16px;
    color: var(--color-text-faint);
  }

  .hero-card {
    position: relative;
    aspect-ratio: 910 / 448;
    overflow: clip;
    /* Horizontal swipes go to pixel-field.js, vertical ones scroll the page */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
    /* Read by pixel-field.js; the photo is the no-JS fallback.
       --scene-tint multiplies the photo (white = untouched) */
    --scene-tint: #FFFFFF;
  }

  .hero-card.is-dragging {
    cursor: grabbing;
  }

  :global(html[data-theme='dark']) .hero-card {
    --scene-tint: #4A5680;
  }

  .hero-title {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .hero-lead {
    max-width: 450px;
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--color-text-strong);
  }

  /* ── Hover: the photo's bottom edge rises by the bar's height, and the bar
     fades in underneath (Paper: photo 448 → 420, bar 28 tall). Shown for
     keyboard focus too, and always on screens that can't hover. ── */
  .hero-card {
    --bar: 28px;
    --dot-off: #E5E5E5;
  }

  :global(html[data-theme='dark']) .hero-card {
    --dot-off: rgba(255, 255, 255, 0.18);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    overflow: clip;
    clip-path: inset(0);
    /* No-JS fallback; the canvas covers it */
    background: url(/assets/index/hero-skyline.jpg) center 49% / cover;
    transition: clip-path 0.35s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .hero-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--bar);
    display: flex;
    align-items: center;
    justify-content: space-between;
    opacity: 0;
    visibility: hidden;
    /* Out: fades quickly while the photo grows back over it */
    transition: opacity 0.15s ease, visibility 0s 0.15s;
  }

  .hero-card:hover .hero-photo,
  .hero-card:focus-within .hero-photo {
    clip-path: inset(0 0 var(--bar) 0);
  }

  .hero-card:hover .hero-bar,
  .hero-card:focus-within .hero-bar {
    opacity: 1;
    visibility: visible;
    /* In: waits for the photo to finish rising (0.35s), then fades in */
    transition: opacity 0.25s ease 0.35s, visibility 0s;
  }

  @media (hover: none) {
    .hero-photo {
      clip-path: inset(0 0 var(--bar) 0);
    }

    .hero-bar {
      opacity: 1;
      visibility: visible;
    }
  }

  .hero-modes {
    display: flex;
    gap: 6px;
  }

  .hero-mode,
  .hero-clear {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 12px;
    line-height: var(--bar);
    color: var(--color-text-strong);
    cursor: pointer;
  }

  .hero-mode:hover,
  .hero-clear:hover {
    color: var(--color-text-accent);
  }

  .hero-mode[aria-pressed='true'] {
    font-weight: 700;
    cursor: default;
  }

  .hero-mode:hover[aria-pressed='true'] {
    color: var(--color-text-strong);
  }

  .hero-mode:focus-visible,
  .hero-clear:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: 2px;
  }

  /* ── Draw mode ── The strip stays open as the toolbar, the photo dots give
     way to the pens, and the surface fades in over the photo. */
  .hero-card.is-drawing {
    cursor: crosshair;
    --draw-bg: #F6F6F6;
  }

  :global(html[data-theme='dark']) .hero-card.is-drawing {
    --draw-bg: var(--color-bg-secondary);
  }

  .hero-card.is-drawing .hero-photo {
    clip-path: inset(0 0 var(--bar) 0);
  }

  .hero-card.is-drawing .hero-bar {
    opacity: 1;
    visibility: visible;
  }

  .hero-pens,
  .hero-card.is-drawing .hero-dots {
    display: none;
  }

  .hero-card.is-drawing .hero-pens {
    display: flex;
    align-items: center;
    margin-right: -4px;
  }

  .hero-clear {
    margin-right: 12px;
  }

  .hero-draw {
    position: absolute;
    inset: 0;
    background: var(--draw-bg, #F6F6F6);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0s 0.25s;
  }

  .hero-card.is-drawing .hero-draw {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease, visibility 0s;
  }

  .hero-draw canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Fingers draw here rather than scroll the page */
    touch-action: none;
  }

  /* The glow: each stroke's own colour, softened into a halo */
  .hero-glow {
    filter: blur(6px);
    opacity: 0.7;
    pointer-events: none;
  }

  /* Centred in the part above the strip */
  .hero-ink {
    /* Same halo as the pen strokes */
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--color-text-accent) 70%, transparent));
    position: absolute;
    left: 50%;
    top: calc((100% - var(--bar)) / 2);
    width: min(320px, 50%);
    transform: translate(-50%, -50%);
    overflow: visible;
    pointer-events: none;
  }

  .hero-ink path {
    fill: none;
    stroke: var(--color-text-accent);
    /* Drawn at 320 of its 400 units wide, so this matches the 3.5px pen */
    stroke-width: 4.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .hero-ink.is-writing path {
    animation: hero-write 2s cubic-bezier(0.45, 0.05, 0.4, 1) 0.2s forwards;
  }

  .hero-ink.is-gone {
    display: none;
  }

  @keyframes hero-write {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ink path {
      stroke-dashoffset: 0;
    }

    .hero-ink.is-writing path {
      animation: none;
    }
  }

  .hero-dots {
    display: flex;
    /* The last dot's hit area runs 4px past its square; this lines the
       square up with the photo's right edge */
    margin-right: -4px;
  }

  /* 12×28 hit area, 8px square on its left, so squares sit 4px apart */
  .hero-dot,
  .hero-pen {
    width: 12px;
    height: var(--bar);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center start;
  }

  .hero-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--dot-off);
    transition: background-color 0.2s ease;
  }

  .hero-dot:hover::before {
    background: color-mix(in srgb, var(--color-text-accent) 40%, var(--dot-off));
  }

  .hero-dot[aria-pressed='true']::before {
    background: var(--color-text-accent);
  }

  .hero-dot:focus-visible,
  .hero-pen:focus-visible {
    outline: 2px solid var(--color-text-accent);
    outline-offset: -2px;
  }

  /* Each pen shows its colour; the selected one gets a thin ring */
  .hero-pen::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--pen);
    outline: 1px solid transparent;
    outline-offset: 1px;
    transition: outline-color 0.2s ease;
  }

  .hero-pen:hover::before {
    outline-color: color-mix(in srgb, var(--pen) 40%, transparent);
  }

  .hero-pen[aria-pressed='true']::before {
    outline-color: var(--pen);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo,
    .hero-bar {
      transition: none;
    }
  }

  /* Low-res canvas scaled up; pixel-field.js sizes it to whole cells */
  .hero-pixels {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
  }

  /* Hairline grid on the pixel edges, so the pixels read as deliberate.
     --cell comes from pixel-field.js */
  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    --grid-line: rgba(255, 255, 255, 0.14);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--cell, 7px) var(--cell, 7px);
  }

  @media (max-width: 640px) {
    .hero {
      padding: 32px 16px 56px;
    }

    /* Taller crop, so the skyline doesn't shrink to a strip */
    .hero-card {
      aspect-ratio: 4 / 3;
    }

    .hero-title {
      font-size: 32px;
    }
  }
</style>
