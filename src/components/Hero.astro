---
// src/components/Hero.astro
---
<section class="hero">
  <div class="hero-card">
    <div class="hero-intro">
      <div class="hero-photo" role="img" aria-label="Avyay in front of the Golden Gate Bridge"></div>
      <div class="hero-copy">
        <p class="hero-eyebrow type-body-md">Hi, I am Avyay</p>
        <h1 class="hero-title type-title" aria-label="I am a designer. builder. tinkerer. human.">
          <span aria-hidden="true">I am a <span id="heroWord">designer.</span><span class="hero-caret" id="heroCaret"></span></span>
        </h1>
        <p class="hero-lead type-body-md" id="heroLead">I solve problems that make every day better.</p>
      </div>
    </div>
  </div>
</section>

<script src="../scripts/hero.js"></script>

<style>
  /* Full-bleed: opts out of the .main > * content column */
  .hero {
    max-width: none;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    padding: 24px;
    display: flex;
  }

  .hero-card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Equal top/bottom room clears the fixed dock and keeps the intro centered */
    padding: 72px clamp(24px, 8.3vw, 120px);
    border-radius: 24px;
    overflow: clip;
    background-image: linear-gradient(in oklab 180deg, var(--color-warm-bg) 0%, var(--color-cool-bg) 100%);
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .hero-photo {
    width: 172px;
    height: 102px;
    flex-shrink: 0;
    border-radius: 24px;
    background-image: url(/assets/index/hero-photo.jpg);
    background-position: 49.855% 52.168%;
    background-repeat: no-repeat;
    background-size: 200.291%;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  /* Type comes from the .type-* primitives; the eyebrow swaps body-md's
     secondary colour for the accent, as in the Paper hero */
  .hero-eyebrow {
    color: var(--color-text-accent);
  }

  .hero-title {
    text-wrap: pretty;
  }

  /* Dark mode: every hero line takes text-neutral-default (the title already
     does), rather than the secondary colour body-md carries in light. */
  :global(html[data-theme='dark']) .hero-eyebrow,
  :global(html[data-theme='dark']) .hero-lead {
    color: var(--color-text-strong);
  }

  /* Hidden until hero.js starts cycling the word */
  .hero-caret {
    display: none;
    width: 2px;
    height: 0.9em;
    margin-left: 3px;
    vertical-align: -0.08em;
    background-color: var(--color-text-accent);
    animation: hero-caret-blink 1s steps(1) infinite;
  }

  .hero-caret.is-on {
    display: inline-block;
  }

  /* Solid while typing or deleting, blinks only while resting on a word */
  .hero-caret.is-typing {
    animation: none;
  }

  @keyframes hero-caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 12px;
    }

    .hero-card {
      justify-content: center;
      padding-bottom: 120px;
    }

    .hero-intro {
      gap: 20px;
    }
  }
</style>
