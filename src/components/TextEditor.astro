---
// src/components/TextEditor.astro
// The paragraph editor's control panel. Dev only: Layout renders it behind
// import.meta.env.DEV, and the endpoint it talks to exists only while
// `astro dev` is running (see src/dev/text-editor/).

// Taking the script out of the build graph (is:inline, below) also took it out
// of Vite's HMR graph, so the browser held on to its cached copy and kept
// running stale code after every edit. The page is rendered per request in
// dev, so stamping the URL is enough to always get the current file.
const version = Date.now();
---
<aside class="tx-panel" id="txPanel" data-tx-ui aria-label="Paragraph editor">
  <div class="tx-row">
    <span class="tx-title">Edit text</span>
    <button type="button" class="tx-toggle" id="txToggle" aria-pressed="false">Off</button>
  </div>
  <p class="tx-status" id="txStatus" data-tone="error" aria-live="polite" hidden></p>

  <div class="tx-controls" id="txControls" hidden>
    <span class="tx-group-label">Style</span>
    <div class="tx-chips" id="txStyles"></div>
    <span class="tx-group-label">Colour</span>
    <div class="tx-swatches" id="txColors"></div>
  </div>

  <p class="tx-hint">⌘⇧E toggle · Enter save · Esc cancel · ⌘Z undo</p>
</aside>

<style>
  .tx-panel {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 2147483000;
    width: 260px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-bg-default);
    box-shadow: 0 8px 24px var(--color-shadow-soft);
    font-family: var(--font-sans);
  }

  .tx-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tx-title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-strong);
  }

  .tx-toggle {
    padding: 4px 12px;
    border: none;
    border-radius: 9999px;
    background-color: var(--color-quote-bg);
    color: var(--color-text-strong);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .tx-toggle[aria-pressed='true'] {
    background-color: var(--color-text-accent);
    color: var(--color-on-accent);
  }

  .tx-toggle:hover {
    filter: brightness(0.92);
  }

  .tx-status {
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }

  /* Only shown when there is a refusal to report, so it takes no room the
     rest of the time */
  .tx-status[hidden] {
    display: none;
  }

  .tx-status[data-tone='error'] {
    color: var(--color-error);
  }

  .tx-status[data-tone='note'] {
    color: var(--color-text-secondary);
  }

  .tx-hint {
    font-size: 11px;
    line-height: 1.3;
    color: var(--color-text-disabled);
  }

  /* ── Style and colour ──
     Only shown while a paragraph is being edited, so the panel stays small
     the rest of the time. */
  .tx-controls {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 0 2px;
    border-top: 1px solid var(--color-divider);
  }

  .tx-controls[hidden] {
    display: none;
  }

  .tx-group-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-disabled);
  }

  .tx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 4px;
  }

  .tx-swatches {
    display: flex;
    gap: 6px;
  }
</style>

{/* is:inline rather than is:global: a global block is emitted into the
    production stylesheet whenever Astro compiles the component, which
    Layout's import makes it do even where the panel never renders. Inline,
    these rules only exist on a page that actually shows the panel. They still
    need to reach outside the component — the chips are built at runtime and
    the rings land on the page's own paragraphs — and every selector is
    tx-prefixed, so nothing here can collide with the site's own CSS. */}
<style is:inline>
  /* Global because the paragraphs being edited live in every other component.
     box-shadow rather than outline or border, so nothing shifts on hover. */
  html.tx-on p:not([data-tx-ui] p):not(:has(*)) {
    cursor: text;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--color-accent-outline);
  }

  html.tx-on p:not([data-tx-ui] p):not(:has(*)):hover {
    box-shadow: 0 0 0 1px var(--color-text-accent);
  }

  /* ── Chips and swatches ──
     Global, not scoped: these buttons are built at runtime, so they never
     carry the data-astro-cid attribute a scoped rule selects on. */
  .tx-chip {
    padding: 3px 8px;
    border: none;
    border-radius: 6px;
    background-color: var(--color-quote-bg);
    color: var(--color-text-secondary);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
  }

  .tx-chip:hover {
    filter: brightness(0.92);
  }

  .tx-chip[aria-pressed='true'] {
    background-color: var(--color-text-accent);
    color: var(--color-on-accent);
  }

  /* The swatch shows the token it applies; the ring marks the current one */
  .tx-swatch {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: var(--color-swatch, transparent);
    cursor: pointer;
  }

  .tx-swatch[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--color-bg-default), 0 0 0 4px var(--color-text-accent);
  }

  /* Auto: no colour class at all, so it shows a slash rather than a fill */
  .tx-swatch--auto {
    background-image: linear-gradient(
      to bottom right,
      transparent calc(50% - 1px),
      var(--color-text-disabled) calc(50% - 1px),
      var(--color-text-disabled) calc(50% + 1px),
      transparent calc(50% + 1px)
    );
  }

  html.tx-on p.tx-active {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-text-accent);
  }
</style>

{/* is:inline keeps this out of the build graph entirely. A processed
    <script> is collected and bundled whenever Astro compiles the component,
    which Layout's import makes it do even in production, where this never
    renders — that left the whole editor sitting in dist/_astro as an orphan
    asset. Inline, the tag only exists on a page that actually renders it, and
    Vite serves the module straight from src in dev. */}
<script is:inline type="module" src={`/src/scripts/text-editor.js?v=${version}`}></script>
