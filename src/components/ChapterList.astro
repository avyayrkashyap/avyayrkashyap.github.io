---
// src/components/ChapterList.astro
// The sections of the page being read (a case study, About, Now), under
// the sidebar nav: the page's name, then its sections beside a
// column of small diamonds that grow into squares, in blue, around the
// reading position. Hidden until
// chapters.js finds sections; it fills in the title, rows and ticks.
---
<div class="chapters" id="chapterNav" hidden>
  <p class="chapters-title" id="chapterTitle"></p>
  <div class="chapters-body">
    <div class="chapters-ruler" id="chapterRuler" aria-hidden="true"></div>
    <nav class="chapters-list" id="chapterList" aria-label="Sections"></nav>
  </div>
</div>

<script src="../scripts/chapters.js"></script>

<style>
  .chapters {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chapters[hidden] {
    display: none;
  }

  .chapters-title {
    margin: 0;
    font-size: 12px;
    line-height: 1.3;
    color: var(--color-text-disabled);
  }

  .chapters-body {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  /* Small diamonds on an 8px pitch (chapters.js: PITCH, SIZE, MIN), as
     tall as the list; chapters.js turns the ones around the lens into blue
     squares */
  .chapters-ruler {
    flex-shrink: 0;
    width: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding-block: 4px;
  }

  .chapters-ruler :global(span) {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: var(--color-text-strong);
    transform: rotate(45deg) scale(0.4);
  }

  .chapters-list {
    /* Rows' offsetTop is measured against this */
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  /* :global, since chapters.js builds the rows at runtime */
  .chapters-list :global(.chapter-row) {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 16px;
    line-height: 1.3;
    text-align: left;
    color: var(--color-text-strong);
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .chapters-list :global(.chapter-row:hover) {
    color: var(--color-text-accent);
  }
</style>
