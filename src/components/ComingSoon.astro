---
// src/components/ComingSoon.astro
import { ThinkingOrb } from 'thinking-orbs';

interface Props {
  note: string;
}

const { note } = Astro.props;
---
<section class="soon">
  <svg class="soon-orb-defs" aria-hidden="true" focusable="false">
    <filter id="orbAccentLight" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.10196
                0 0 0 0 0.42353
                0 0 0 0 0.94118
                0 0 0 1 0" />
    </filter>
    <filter id="orbAccentDark" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36078
                0 0 0 0 0.59216
                0 0 0 0 1
                0 0 0 1 0" />
    </filter>
  </svg>

  <span class="soon-orb" aria-hidden="true">
    <ThinkingOrb client:load state="working" size={64} theme="light" aria-hidden={true} />
  </span>
  <h1 class="soon-title t-display">Coming soon.</h1>
  <p class="soon-note t-body">{note}</p>
  <a class="soon-back" href="/">← Back home</a>
</section>

<style>
  .soon {
    min-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    gap: 16px;
  }

  .soon-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .soon-orb {
    display: inline-flex;
    line-height: 0;
    filter: url(#orbAccentLight);
    margin-bottom: 8px;
  }

  :global(html[data-theme='dark']) .soon-orb {
    filter: url(#orbAccentDark);
  }

  .soon-title {
    transition: color 0.3s ease;
  }

  .soon-note {
    max-width: 40ch;
    transition: color 0.3s ease;
  }

  .soon-back {
    margin-top: 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .soon-back:hover {
    opacity: 1;
  }
</style>
