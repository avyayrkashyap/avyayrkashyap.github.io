---
// src/components/ComingSoon.astro
import { ThinkingOrb } from 'thinking-orbs';

interface Props {
  note: string;
}

const { note } = Astro.props;
---
<section class="soon">
  <svg class="soon-orb-defs" aria-hidden="true" focusable="false">
    <!-- --color-text-accent light: #155ED3 -->
    <filter id="orbAccentLight" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.08235
                0 0 0 0 0.36863
                0 0 0 0 0.82745
                0 0 0 1 0" />
    </filter>
    <!-- --color-text-accent dark: #5C97FF -->
    <filter id="orbAccentDark" color-interpolation-filters="sRGB">
      <feColorMatrix
        type="matrix"
        values="0 0 0 0 0.36078
                0 0 0 0 0.59216
                0 0 0 0 1
                0 0 0 1 0" />
    </filter>
  </svg>

  <span class="soon-orb" aria-hidden="true">
    <ThinkingOrb client:load state="working" size={64} theme="light" aria-hidden={true} />
  </span>
  <h1 class="soon-title type-title">Coming soon.</h1>
  <p class="soon-note type-body-md">{note}</p>
  <a class="soon-back type-body-sm" href="/">← Back home</a>
</section>

<style>
  .soon {
    min-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px;
    gap: 16px;
  }

  .soon-orb-defs {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .soon-orb {
    display: inline-flex;
    line-height: 0;
    filter: url(#orbAccentLight);
    margin-bottom: 8px;
  }

  :global(html[data-theme='dark']) .soon-orb {
    filter: url(#orbAccentDark);
  }

  .soon-title {
    transition: color 0.3s ease;
  }

  .soon-note {
    max-width: 40ch;
    transition: color 0.3s ease;
  }

  /* body-sm, in the accent rather than secondary text */
  .soon-back {
    margin-top: 16px;
    color: var(--color-text-accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .soon-back:hover {
    opacity: 1;
  }
</style>
