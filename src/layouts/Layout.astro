---
// src/layouts/Layout.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Dock from '../components/Dock.astro';
import Sheet from '../components/Sheet.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /* Server-render the sheet open (with the homepage behind it). The page's
     sheet content goes in slot="sheet". Paths must match SHEET_PATHS in sheet.js */
  sheetOpen?: boolean;
  sheetLabel?: string;
}

const { title, sheetOpen = false, sheetLabel } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class:list={{ 'sheet-open': sheetOpen }}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&family=Manrope:wght@200..800&family=Platypi:wght@300..800&display=swap" rel="stylesheet" />
  <!-- Material Symbols subset: apps (mobile dock menu) and call_made (experiment card arrow). Google requires icon_names in alphabetical order -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=apps,call_made" />
  <script is:inline>
    // Registered before the ClientRouter's own popstate listener, so the sheet
    // (sheet.js) can claim Back/Forward moves that only open, swap or close it
    // before the router swaps the page. Bound once per document.
    if (!window.__sheetPopBound) {
      window.__sheetPopBound = true;
      addEventListener('popstate', function (e) {
        if (window.__sheetPopState) window.__sheetPopState(e);
      });
    }
  </script>
  <ClientRouter />
  <script is:inline>
    (function () {
      function applyStoredTheme() {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyStoredTheme();
      // ClientRouter morphs <html>'s attributes to match the incoming page on
      // each navigation, which wipes data-theme since it's only ever set
      // client-side. Reapply it right after every swap.
      document.addEventListener('astro:after-swap', applyStoredTheme);
    })();
  </script>
</head>
<body>
  <main class="main" inert={sheetOpen}>
    <slot />
    <Footer />
  </main>
  <Sheet open={sheetOpen} label={sheetLabel}>
    <slot name="sheet" />
  </Sheet>
  <Dock top={sheetOpen} />
</body>
</html>
