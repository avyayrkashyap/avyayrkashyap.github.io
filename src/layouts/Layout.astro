---
// src/layouts/Layout.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import TextEditor from '../components/TextEditor.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  /* Case studies: links out (the live site, a write-up), shown as cards
     under the sections in the sidebar */
  links?: { label: string; title: string; href: string }[];
}

const { title, links = [] } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Material Symbols subset: call_made (experiment card arrow). Google requires icon_names in alphabetical order -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=call_made" />
  <ClientRouter />
  <script is:inline>
    (function () {
      function applyStoredTheme() {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyStoredTheme();
      // ClientRouter morphs <html>'s attributes to match the incoming page on
      // each navigation, which wipes data-theme since it's only ever set
      // client-side. Reapply it right after every swap.
      document.addEventListener('astro:after-swap', applyStoredTheme);
    })();
  </script>
</head>
<body>
  <Sidebar links={links} />
  <main class="main">
    <slot />
    <Footer />
  </main>
  {/* Dev only: click-to-edit paragraph copy, written back to src/ */}
  {import.meta.env.DEV && <TextEditor />}
  <script>
    // Site-wide so their listeners exist before any in-site navigation
    import '../scripts/clips.js';
    import '../scripts/zoom.js';

    // A homepage cover and its case study's hero share a data-cover. Name
    // them for the view transition only when both ends have one, so the card
    // morphs into place; unpaired covers just fade with the page instead of
    // floating over it on their own.
    let incoming: HTMLElement | null = null; // the card on the page being opened
    document.addEventListener('astro:before-preparation', (e) => {
      const load = e.loader;
      e.loader = async () => {
        await load();
        incoming = null;
        for (const el of document.querySelectorAll<HTMLElement>('[data-cover]')) {
          // Left over from the transition that brought us here
          el.style.viewTransitionName = '';
          const twin = e.newDocument.querySelector<HTMLElement>(`[data-cover="${el.dataset.cover}"]`);
          if (!twin) continue;
          el.style.viewTransitionName = twin.style.viewTransitionName = `cover-${el.dataset.cover}`;
          incoming = twin;
        }
      };
    });

    // The new page is captured right after the swap, so the card has to be on
    // screen by then. On Back, Astro's scroll restore glides (html scrolls
    // smoothly) and lands too late; a link home opens at the top, with the
    // card further down. Jump there instantly instead.
    document.addEventListener('astro:after-swap', () => {
      if (!incoming) return;
      scrollTo({ top: history.state?.scrollY ?? 0, behavior: 'instant' });
      const r = incoming.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) incoming.scrollIntoView({ block: 'center', behavior: 'instant' });
      incoming = null;
    });
  </script>
</body>
</html>
